#!/bin/sh

npm run lint && npm run type-check && node -e "
const {R2_ACCOUNT_ID,R2_ACCESS_KEY_ID,R2_SECRET_ACCESS_KEY,R2_BUCKET}=process.env;
if (!R2_ACCOUNT_ID||!R2_ACCESS_KEY_ID||!R2_SECRET_ACCESS_KEY||!R2_BUCKET) {
  console.log('SKIP thumbnail check: R2 env vars not configured');
  process.exit(0);
}
require('child_process').execSync('node scripts/check-blog-thumbnails.mjs --staged', {stdio:'inherit'});
" && python3 scripts/check-content-collisions.py || {
  echo "pre-commit: content collision detected (see above). Aborting commit." >&2
  echo "  Fix: keep the newest .mdx in each collision group, delete the rest." >&2
  echo "  See apps/web/scripts/dedup-2026-08-22.json for the pattern." >&2
  exit 1
}
