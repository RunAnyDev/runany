---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/10 mt-16 py-10 bg-slate-950/60" data-cta-section="footer">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-6">
      <div>
        <p class="text-slate-200 font-semibold text-sm">runany.dev</p>
        <p class="text-slate-400 text-xs mt-1">Practical guides for AI tools, local LLMs, and developer workflows.</p>
      </div>
      <nav aria-label="Footer navigation" class="flex flex-wrap gap-4 text-sm text-slate-400">
        <a href="/blog/" class="hover:text-cyan-300 transition-colors">Blog</a>
        <a href="/about/" class="hover:text-cyan-300 transition-colors">About</a>
        <a href="/rss.xml" class="hover:text-cyan-300 transition-colors">RSS</a>
        <a href="/sitemap.xml" class="hover:text-cyan-300 transition-colors">Sitemap</a>
        <a href="/contact/" class="hover:text-cyan-300 transition-colors">Contact</a>
      </nav>
    </div>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-t border-white/5 pt-6">
      <p class="text-slate-500 text-sm">&copy; {currentYear} runany.dev. All rights reserved.</p>
      <div class="flex items-center gap-4 text-sm text-slate-400">
        <a href="mailto:du@runany.dev" class="hover:text-cyan-300 transition-colors" aria-label="Email du@runany.dev" data-cta="Email" data-cta-location="footer-contact">du@runany.dev</a>
        <a href="https://twitter.com/runanydev" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors" aria-label="Follow on X (Twitter)" data-cta="Twitter" data-cta-location="footer-social">X / Twitter</a>
        <a href="https://github.com/runanydev" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors" aria-label="GitHub profile" data-cta="GitHub" data-cta-location="footer-social">GitHub</a>
      </div>
    </div>
  </div>
</footer>
