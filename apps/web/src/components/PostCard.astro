---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category: string;
  tags: string[];
  image?: { url: string; alt: string };
  featured?: boolean;
}

const { title, description, pubDate, slug, category, tags, image, featured } = Astro.props;

const formatDate = (d: any) => {
  if (!d) return '';
  if (typeof d === 'string') return new Date(d).toLocaleDateString();
  if (typeof d === 'object' && d.toLocaleDateString) return d.toLocaleDateString();
  return '';
};
---

<article class:list={['card hover:shadow-lg transition-shadow', featured && 'border-primary']}>
  {image && (
    <img
      src={image.url}
      alt={image.alt}
      width="600"
      height="338"
      class="w-full h-40 object-cover rounded-lg mb-4"
      loading="lazy"
    />
  )}
  {featured && <span class="text-xs text-primary font-medium">Featured</span>}
  <h3 class="text-xl font-semibold mb-2">
    <a href={`/blog/${slug}`} class="hover:text-primary transition-colors">{title}</a>
  </h3>
  <p class="text-gray-600 dark:text-gray-400 text-sm mb-3 line-clamp-2">{description}</p>
  <div class="flex items-center gap-2 text-xs text-gray-500">
    <a href={`/category/${category.toLowerCase()}`} class="link">{category}</a>
    <span>·</span>
    <span>{formatDate(pubDate)}</span>
  </div>
  <div class="flex gap-2 mt-3">
    {tags.slice(0, 3).map(tag => (
      <span class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded">#{tag}</span>
    ))}
  </div>
</article>