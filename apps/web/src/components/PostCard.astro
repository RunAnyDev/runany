---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category: string;
  tags: string[];
  image?: { url: string; alt: string };
  featured?: boolean;
}

const { title, description, pubDate, slug, category, tags, image, featured } = Astro.props;

const formatDate = (d: any) => {
  if (!d) return '';
  if (typeof d === 'string') return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  if (typeof d === 'object' && d.toLocaleDateString) return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  return '';
};
---

<article class:list={[
  'group relative overflow-hidden rounded-3xl border border-white/10 bg-slate-950/75 shadow-2xl shadow-slate-950/30 transition duration-300 hover:-translate-y-1 hover:border-cyan-300/40 hover:shadow-cyan-950/30',
  featured && 'md:col-span-1 ring-1 ring-cyan-300/25'
]}>
  <a href={`/blog/${slug}/`} class="block" aria-label={`Read ${title}`}>
    <div class="relative aspect-[16/9] overflow-hidden bg-slate-900">
      {image ? (
        <>
          <img
            src={image.url}
            alt={image.alt || title}
            width={600}
            height={338}
            class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
            data-img-with-fallback
          />
          <div class="hidden absolute inset-0 flex-col bg-gradient-to-br from-violet-500/25 via-slate-800 to-cyan-400/25">
            <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.10)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.10)_1px,transparent_1px)] bg-[size:28px_28px] opacity-35"></div>
            <div class="absolute left-5 top-5 rounded-full border border-white/15 bg-slate-950/55 px-3 py-1 text-xs font-semibold text-cyan-100 backdrop-blur">
              {category}
            </div>
          </div>
        </>
      ) : (
        <div class="relative h-full w-full bg-gradient-to-br from-violet-500/25 via-slate-800 to-cyan-400/25">
          <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.10)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.10)_1px,transparent_1px)] bg-[size:28px_28px] opacity-35"></div>
          <div class="absolute left-5 top-5 rounded-full border border-white/15 bg-slate-950/55 px-3 py-1 text-xs font-semibold text-cyan-100 backdrop-blur">
            {category}
          </div>
          <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-slate-950/70 to-transparent"></div>
        </div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/55 via-transparent to-transparent"></div>
    </div>
  </a>

  <div class="p-5">
    <div class="mb-3 flex items-center justify-between gap-3 text-xs font-medium text-slate-400">
      <a href={`/category/${category.toLowerCase()}/`} class="rounded-full border border-cyan-300/20 bg-cyan-300/10 px-3 py-1 text-cyan-200 hover:border-cyan-300/50">
        {category}
      </a>
      <time datetime={pubDate instanceof Date ? pubDate.toISOString() : new Date(pubDate as any).toISOString()}>{formatDate(pubDate)}</time>
    </div>

    {featured && <span class="mb-2 inline-flex text-xs font-semibold uppercase tracking-[0.22em] text-lime-300">Featured</span>}

    <h3 class="mb-3 text-xl font-bold leading-tight text-white">
      <a href={`/blog/${slug}/`} class="hover:text-cyan-200 transition-colors">{title}</a>
    </h3>

    <p class="mb-4 line-clamp-2 text-sm leading-6 text-slate-400">{description}</p>

    <div class="flex flex-wrap gap-2">
      {tags.slice(0, 3).map(tag => (
        <a href={`/tags/${tag.toLowerCase()}/`} class="rounded-full bg-white/5 px-2.5 py-1 text-xs text-slate-300 hover:bg-white/10 hover:text-cyan-200">
          #{tag}
        </a>
      ))}
    </div>
  </div>
</article>

<script>
  document.querySelectorAll('img[data-img-with-fallback]').forEach(function (img) {
    img.addEventListener('error', function () {
      this.style.display = 'none';
      const fallback = this.nextElementSibling;
      if (fallback) fallback.style.display = 'flex';
    });
  });
</script>
