---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <div class="sticky top-24 p-4 bg-gray-50 dark:bg-gray-800 rounded-xl">
    <h4 class="font-semibold mb-3 text-sm uppercase tracking-wide text-gray-500">On This Page</h4>
    <nav class="space-y-2">
      {filteredHeadings.map(heading => (
        <a
          href={`#${heading.slug}`}
          class:list={[
            'block text-sm hover:text-primary transition-colors',
            heading.depth === 3 && 'ml-4',
            heading.depth > 3 && 'ml-8',
          ]}
        >
          {heading.text}
        </a>
      ))}
    </nav>
  </div>
)}

<style>
  a.active {
    @apply text-primary font-medium;
  }
</style>