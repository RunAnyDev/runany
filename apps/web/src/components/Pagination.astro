---
import { getPagePath, getPageWindow } from '@/utils/pagination';

interface Props {
  currentPage: number;
  totalPages: number;
  /** Total number of posts, used for the human-readable summary line. */
  totalPosts?: number;
}

const { currentPage, totalPages, totalPosts } = Astro.props;

const linkClass =
  'rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300 transition hover:border-cyan-300/40 hover:text-cyan-200';
const activeClass =
  'rounded-full border border-cyan-300/40 bg-cyan-300/15 px-4 py-2 text-sm font-semibold text-cyan-200';
const disabledClass =
  'rounded-full border border-white/5 bg-white/5 px-4 py-2 text-sm text-slate-600';

// Build a flat list of page numbers with gap markers so the nav renders
// without fragment keys.
const pages = getPageWindow(currentPage, totalPages);
const navItems: Array<number | 'gap'> = [];
pages.forEach((page, index) => {
  if (index > 0 && page - pages[index - 1] > 1) navItems.push('gap');
  navItems.push(page);
});

const hasPrev = currentPage > 1;
const hasNext = currentPage < totalPages;
---

{
  totalPages > 1 && (
    <nav aria-label="Blog pages" class="mt-12 flex flex-col items-center gap-4">
      <div class="flex flex-wrap items-center justify-center gap-2">
        {hasPrev ? (
          <a href={getPagePath(currentPage - 1)} class={linkClass} rel="prev">
            ← Newer
          </a>
        ) : (
          <span class={disabledClass} aria-disabled="true">
            ← Newer
          </span>
        )}

        {navItems.map((item) =>
          item === 'gap' ? (
            <span class="px-1 text-sm text-slate-600">…</span>
          ) : item === currentPage ? (
            <span class={activeClass} aria-current="page">
              {item}
            </span>
          ) : (
            <a href={getPagePath(item)} class={linkClass}>
              {item}
            </a>
          )
        )}

        {hasNext ? (
          <a href={getPagePath(currentPage + 1)} class={linkClass} rel="next">
            Older →
          </a>
        ) : (
          <span class={disabledClass} aria-disabled="true">
            Older →
          </span>
        )}
      </div>

      {totalPosts !== undefined && (
        <p class="text-sm text-slate-500">
          Page {currentPage} of {totalPages} · {totalPosts} posts
        </p>
      )}
    </nav>
  )
}
