---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
];
---

<header class="border-b border-white/10 sticky top-0 bg-slate-950/80 backdrop-blur-xl z-50">
  <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight">
      <span class="text-cyan-300">runany</span><span class="text-slate-400">.dev</span>
    </a>
    <ul class="flex gap-6 text-sm font-medium text-slate-300">
      {navItems.map(item => (
        <li>
          <a href={item.href} class="hover:text-cyan-300 transition-colors">{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
