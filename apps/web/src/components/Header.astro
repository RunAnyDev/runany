---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
];
---

<header class="border-b border-gray-200 dark:border-gray-800 sticky top-0 bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm z-50">
  <nav class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-bold">runany.dev</a>
    <ul class="flex gap-6">
      {navItems.map(item => (
        <li>
          <a href={item.href} class="hover:text-primary transition-colors">{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>