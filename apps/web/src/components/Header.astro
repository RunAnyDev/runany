---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'About', href: '/about/' },
  { label: 'DevKit', href: 'https://kit.runany.dev/', external: true },
];
---

<header class="border-b border-white/10 sticky top-0 bg-slate-950/80 backdrop-blur-xl z-50" data-cta-section="header">
  <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight">
      <span class="text-cyan-300">runany</span><span class="text-slate-400">.dev</span>
    </a>
    <ul class="flex gap-6 text-sm font-medium text-slate-300">
      {navItems.map(item => (
        <li>
          {item.external ? (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class="hover:text-green-400 transition-colors text-green-400" data-cta={item.label} data-cta-location="header-nav">{item.label}</a>
          ) : (
            <a href={item.href} class="hover:text-cyan-300 transition-colors">{item.label}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>
