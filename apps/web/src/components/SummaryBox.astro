---
interface Props {
  title: string;
  tags: string[];
  description?: string;
}

const { title, tags, description } = Astro.props;
---

<aside 
  class="mt-12 rounded-2xl border border-cyan-300/20 bg-cyan-300/5 p-6"
  aria-label="Article summary"
  itemscope
  itemtype="https://schema.org/WebPageElement"
>
  <meta itemprop="name" content="Article Summary" />
  
  <h3 class="font-semibold mb-3 text-lg text-white" itemprop="description">TL;DR Summary</h3>
  
  {description && (
    <p class="text-slate-300 mb-4 leading-relaxed">
      {description}
    </p>
  )}
  
  <p class="text-sm text-slate-500 mb-3">Topics covered:</p>
  <ul class="space-y-1 mb-4">
    {tags.map(tag => (
      <li class="flex items-center gap-2 text-sm">
        <span class="text-cyan-300">→</span>
        <a href={`/tags/${tag.toLowerCase()}`} class="text-slate-300 hover:text-cyan-300 transition-colors">
          #{tag}
        </a>
      </li>
    ))}
  </ul>

  <!-- AI-friendly structured data -->
  <meta itemprop="text" content={`Article: ${title}. Tags: ${tags.join(', ')}. ${description || ''}`} />
</aside>
