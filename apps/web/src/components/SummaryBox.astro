---
interface Props {
  title: string;
  tags: string[];
}

const { title, tags } = Astro.props;
---

<div class="mt-12 p-6 bg-gray-50 dark:bg-gray-800 rounded-xl">
  <h3 class="font-semibold mb-3">Summary</h3>
  <p class="text-gray-600 dark:text-gray-400 mb-4">
    This article covered: <strong>{title}</strong>
  </p>
  <div class="flex flex-wrap gap-2">
    {tags.map(tag => (
      <a href={`/tags/${tag.toLowerCase()}`} class="text-sm px-3 py-1 bg-gray-200 dark:bg-gray-700 rounded-full hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">
        #{tag}
      </a>
    ))}
  </div>
</div>