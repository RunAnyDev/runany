{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cicada",
  "scopeName": "source.cicada",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#events" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.cicada",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cicada",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cicada",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cicada",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cicada",
          "match": "\\b(?:fn|let|if|elif|else|for|in|where|mut|cache|run_on|title)\\b"
        },
        {
          "name": "storage.type.cicada",
          "match": "\\b(?:bool|number|string|list|record|unit)\\b"
        }
      ]
    },
    "events": {
      "patterns": [
        {
          "name": "support.function.event.cicada",
          "match": "\\b(?:on|git|event)\\b(?=\\.)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.definition.cicada",
          "match": "(?<=\\bfn\\s)([A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "entity.name.function.call.cicada",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.cicada",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cicada",
          "match": "(?:==|!=|<=|>=|&&|\\|\\||[+\\-*/=<>])"
        }
      ]
    }
  }
}
