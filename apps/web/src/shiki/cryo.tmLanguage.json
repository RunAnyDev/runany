{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cryo",
  "scopeName": "source.cryo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#union-labels" },
    { "include": "#directives" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cryo",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cryo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cryo",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "union-labels": {
      "patterns": [
        {
          "name": "entity.name.tag.cryo",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "support.function.directive.cryo",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=!)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cryo",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cryo",
          "match": "\\b(?:fn|if|else|match|loop|in|of|return|select)\\b"
        },
        {
          "name": "storage.modifier.cryo",
          "match": "\\b(?:var|mut|const|type|module|import|from|as)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.cryo",
          "match": "\\b(?:int|str|bool|null|pipe|array|tuple)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.cryo",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.definition.cryo",
          "match": "(?<=\\bfn\\s)([A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "variable.other.definition.cryo",
          "match": "(?<=\\bvar\\s)([A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "entity.name.function.call.cryo",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cryo",
          "match": "(?:\\.\\.<|\\.\\.|->|<-|=>|::|==|<>|<=|>=|&&|\\|\\||[+\\-*/%=<>!])"
        }
      ]
    }
  }
}
