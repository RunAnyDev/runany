---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  appendSiteNameToTitle?: boolean;
  robots?: string;
  article?: boolean;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  tags?: string[];
  category?: string;
  author?: string;
  readingTime?: number;
  structuredData?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = '',
  image = '/og-default.png',
  canonicalURL = Astro.url.href,
  appendSiteNameToTitle = true,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1',
  article = false,
  pubDate,
  updatedDate,
  tags = [],
  category,
  author = 'Du',
  readingTime,
  structuredData = [],
} = Astro.props;

const siteUrl = 'https://runany.dev';
const siteName = 'runany.dev';
const authorUrl = 'https://github.com/meesudzu';
const documentTitle = appendSiteNameToTitle ? `${title} | ${siteName}` : title;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const hasGa4 = Boolean(gaMeasurementId);

const trimDescription = (value: string, limit = 160) => {
  const normalized = value.replace(/\s+/g, ' ').trim();
  if (normalized.length <= limit) return normalized;

  const truncated = normalized.slice(0, limit - 1);
  const lastSpace = truncated.lastIndexOf(' ');
  return `${(lastSpace > 100 ? truncated.slice(0, lastSpace) : truncated).trim()}…`;
};

const metaDescription = trimDescription(description);

const normalizeCanonicalUrl = (value: string) => {
  try {
    const url = new URL(value, siteUrl);
    const isInternal = url.origin === siteUrl;
    const hasFileExtension = /\.[a-z0-9]+$/i.test(url.pathname);

    if (isInternal && !hasFileExtension && !url.pathname.endsWith('/')) {
      url.pathname = `${url.pathname}/`;
    }

    return url.toString();
  } catch {
    return value;
  }
};

const resolvedCanonicalURL = normalizeCanonicalUrl(canonicalURL);

// Format dates safely - handle both string and Date
const formatDate = (d: any) => {
  if (!d) return null;
  if (typeof d === 'string') return new Date(d).toISOString();
  return d.toISOString ? d.toISOString() : null;
};

// Base TechArticle JSON-LD
const techArticleJsonLd = article ? {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: metaDescription,
  image: image.startsWith('http') ? image : `${siteUrl}${image}`,
  datePublished: formatDate(pubDate),
  dateModified: formatDate(updatedDate) || formatDate(pubDate),
  url: resolvedCanonicalURL,
  author: {
    '@type': 'Person',
    name: author,
    url: authorUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: siteName,
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
  },
  keywords: tags.length > 0 ? tags.join(', ') : undefined,
  articleSection: category,
  wordCount: readingTime ? readingTime * 200 : undefined,
  timeRequired: readingTime ? `PT${readingTime}M` : undefined,
} : null;

// BreadcrumbList for navigation context
const breadcrumbJsonLd = article ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: resolvedCanonicalURL },
  ],
} : null;

const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
const articlePublishedTime = formatDate(pubDate);
const articleModifiedTime = formatDate(updatedDate);
const extraStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/favicon.svg`,
  },
  email: 'du@runany.dev',
  sameAs: [
    'https://twitter.com/runanydev',
    'https://github.com/runanydev',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'du@runany.dev',
    contactType: 'editorial',
  },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{documentTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="author" content={author} />
  {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
  <link rel="canonical" href={resolvedCanonicalURL} />
  <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS Feed`} href="/rss.xml" />
  <link rel="search" type="application/opensearchdescription+xml" title={`${siteName} Search`} href="/opensearch.xml" />
  <link rel="sitemap" type="application/xml" title={`${siteName} Sitemap`} href="/sitemap.xml" />
  <link rel="alternate" hreflang="en" href={resolvedCanonicalURL} />
  <link rel="alternate" hreflang="x-default" href={resolvedCanonicalURL} />
  <link rel="preconnect" href="https://cdn.runany.dev" />
  <link rel="dns-prefetch" href="https://cdn.runany.dev" />
  {hasGa4 && <link rel="preconnect" href="https://www.googletagmanager.com" />}
  {hasGa4 && <link rel="dns-prefetch" href="https://www.googletagmanager.com" />}
  {hasGa4 && <link rel="dns-prefetch" href="https://www.google-analytics.com" />}
  <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  
  <meta name="theme-color" content="#020617" />
  
  <!-- Open Graph -->
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:alt" content={title + " | runany.dev"} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={resolvedCanonicalURL} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="en_US" />
  
  {article && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
  {article && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
  {article && tags.map(tag => <meta property="article:tag" content={tag} />)}
  {article && category && <meta property="article:section" content={category} />}
  {article && <meta property="article:author" content={author} />}
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={title + " | runany.dev"} />
  <meta name="twitter:site" content="@runanydev" />
  <meta name="twitter:creator" content="@runanydev" />
  
  <!-- AI Bot Meta -->
  <meta name="robots" content={robots} />
  <meta name="ai-content-detect" content="true" />

  <!-- Security / Privacy -->
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' https://cdn.runany.dev data: https:; font-src 'self'; connect-src 'self' https://static.cloudflareinsights.com https://www.google-analytics.com https://www.googletagmanager.com; base-uri 'self'; form-action 'self'" />
  
  <!-- AI Crawler Specific -->
  <meta name="GPTBot" content="index, follow" />
  <meta name="ClaudeBot" content="index, follow" />
  <meta name="PerplexityBot" content="index, follow" />
  
  <!-- Structured Data -->
  {techArticleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(techArticleJsonLd)} />}
  {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
  {extraStructuredData.map(data => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {hasGa4 && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>}
  {hasGa4 && (
    <script is:inline define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      // eslint-disable-next-line prefer-rest-params
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaMeasurementId, {
        anonymize_ip: true,
        page_path: window.location.pathname,
      });

      const normalizeLabel = (value) => (value || '').replace(/\s+/g, ' ').trim().slice(0, 120);
      const findTrackedLink = (target) => target instanceof Element ? target.closest('a[href]') : null;
      const findTrackedCta = (target) => target instanceof Element ? target.closest('[data-cta]') : null;
      const isOutboundLink = (link) => {
        const href = link.getAttribute('href') || '';
        if (!href || href.startsWith('#') || href.startsWith('/') || href.startsWith('mailto:') || href.startsWith('tel:')) return false;

        try {
          const url = new URL(href, window.location.origin);
          return url.origin !== window.location.origin;
        } catch {
          return false;
        }
      };

      document.addEventListener('click', (event) => {
        const cta = findTrackedCta(event.target);
        if (cta) {
          const ctaName = normalizeLabel(cta.getAttribute('data-cta') || cta.textContent || cta.getAttribute('aria-label'));
          const ctaLocation = normalizeLabel(cta.getAttribute('data-cta-location') || cta.closest('[data-cta-section]')?.getAttribute('data-cta-section') || 'unknown');

          gtag('event', 'cta_click', {
            event_category: 'engagement',
            event_label: ctaName,
            cta_name: ctaName,
            cta_location: ctaLocation,
            page_path: window.location.pathname,
          });
        }

        const link = findTrackedLink(event.target);
        if (!link || !isOutboundLink(link)) return;

        const url = new URL(link.href, window.location.origin);
        const linkText = normalizeLabel(link.getAttribute('data-outbound-label') || link.textContent || link.getAttribute('aria-label') || url.hostname);

        gtag('event', 'outbound_click', {
          event_category: 'outbound',
          event_label: linkText,
          link_url: url.toString(),
          link_domain: url.hostname,
          outbound: true,
          page_path: window.location.pathname,
        });
      }, { capture: true });
    </script>
  )}
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-cyan-300 selection:text-slate-950">
  <div class="fixed inset-0 -z-10 bg-[radial-gradient(circle_at_20%_10%,rgba(34,211,238,0.16),transparent_28rem),radial-gradient(circle_at_80%_0%,rgba(139,92,246,0.18),transparent_26rem),linear-gradient(180deg,#020617_0%,#0f172a_48%,#020617_100%)]"></div>
  <div class="fixed inset-0 -z-10 opacity-35 bg-[linear-gradient(rgba(148,163,184,0.08)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.08)_1px,transparent_1px)] bg-[size:48px_48px]"></div>
  <Header />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  article :is(h1, h2, h3, h4, h5, h6) {
    scroll-margin-top: 6rem;
  }
</style>
