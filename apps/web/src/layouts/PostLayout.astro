---
import BaseLayout from './BaseLayout.astro';
import TOC from '@/components/TOC.astro';
import SummaryBox from '@/components/SummaryBox.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  image?: { url: string; alt: string };
  readingTime?: number;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, pubDate, updatedDate, category, tags, image, readingTime, headings } = Astro.props;

// Ensure pubDate is a Date object for toLocaleDateString
const formattedDate = typeof pubDate === 'string' 
  ? new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={title}
  description={description}
  image={image?.url}
  article={true}
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
  category={category}
>
  <article class="max-w-4xl mx-auto px-4 py-8">
    {image && (
      <img
        src={image.url}
        alt={image.alt}
        width="1200"
        height="630"
        class="w-full h-64 md:h-96 object-cover rounded-xl mb-8"
      />
    )}
    
    <header class="mb-8">
      <p class="text-sm text-gray-500 mb-2">
        <a href={`/category/${category.toLowerCase()}`} class="link">{category}</a>
        {' · '}
        {formattedDate}
        {readingTime && <span> · {readingTime} min read</span>}
      </p>
      <h1 class="text-4xl font-bold mb-4">{title}</h1>
      <p class="text-xl text-gray-600 dark:text-gray-400">{description}</p>
      <div class="flex gap-2 mt-4">
        {tags.map(tag => (
          <a href={`/tags/${tag.toLowerCase()}`} class="text-sm px-3 py-1 bg-gray-100 dark:bg-gray-800 rounded-full">
            #{tag}
          </a>
        ))}
      </div>
    </header>

    {headings && headings.length > 0 && (
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <div class="lg:col-span-3 prose dark:prose-invert max-w-none">
          <slot />
        </div>
        <aside class="lg:col-span-1">
          <TOC headings={headings} />
        </aside>
      </div>
    )}
    
    {!headings || headings.length === 0 && (
      <div class="prose dark:prose-invert max-w-none">
        <slot />
      </div>
    )}

    <SummaryBox title={title} tags={tags} />
  </article>
</BaseLayout>