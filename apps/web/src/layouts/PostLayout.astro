---
import BaseLayout from './BaseLayout.astro';
import SummaryBox from '@/components/SummaryBox.astro';


interface Props {
  title: string;
  description: string;
  slug?: string;
  pubDate: Date | string;
  updatedDate?: Date | string;
  category: string;
  tags: string[];
  indexableTags?: string[];
  author?: string;
  image?: { url: string; alt: string };
  readingTime?: number;
  headings?: { depth: number; slug: string; text: string }[];
  structuredData?: Record<string, any> | Record<string, any>[];
}

const { 
  title, description, pubDate, updatedDate, category, tags, 
  indexableTags = [], author = 'Friday', image, readingTime, headings, slug, structuredData = [] 
} = Astro.props;

const formatDate = (d: any) => {
  if (!d) return '';
  if (typeof d === 'string') return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  if (d instanceof Date) return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  return '';
};

const postSlug = slug || title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const formattedDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;
const dateModifiedIso = updatedDate
  ? (updatedDate instanceof Date ? updatedDate.toISOString() : new Date(updatedDate as string).toISOString())
  : (pubDate instanceof Date ? pubDate.toISOString() : new Date(pubDate as string).toISOString());
const imageUrl = image?.url;
const authorUrl = 'https://github.com/RunAnyDev/runany';

const siteUrl = 'https://runany.dev';
const getSlug = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-\d{6}-/, '').replace(/\.mdx?$/, '');
---

<BaseLayout
  title={title}
  description={description}
  image={imageUrl}
  imageAlt={image?.alt}
  canonicalURL={`${siteUrl}/blog/${postSlug}/`}
  appendSiteNameToTitle={false}
  article={true}
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
  category={category}
  author={author}
  readingTime={readingTime}
  structuredData={structuredData}
>
  <article 
    class="mx-auto max-w-5xl px-4 py-10 md:py-14"
    itemscope
    itemtype="https://schema.org/TechArticle"
  >
    <meta itemprop="dateModified" content={dateModifiedIso} />
    <header class="mb-10">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm">
        <ol class="flex flex-wrap items-center gap-2 text-slate-500">
          <li><a href="/" class="hover:text-cyan-300">Home</a></li>
          <li>›</li>
          <li><a href="/blog/" class="hover:text-cyan-300">Blog</a></li>
          <li>›</li>
          <li><a href={`/category/${category.toLowerCase()}/`} class="hover:text-cyan-300">{category}</a></li>
        </ol>
      </nav>

      <div class:list={['grid gap-8 lg:items-center', imageUrl ? 'lg:grid-cols-[1.05fr_0.95fr]' : 'max-w-3xl']}>
        <div>
          <div class="mb-5 flex flex-wrap items-center gap-3 text-sm text-slate-400" itemprop="articleSection">
            <a href={`/category/${category.toLowerCase()}/`} class="rounded-full border border-cyan-300/25 bg-cyan-300/10 px-3 py-1 font-semibold text-cyan-200">{category}</a>
            <time datetime={pubDate instanceof Date ? pubDate.toISOString() : new Date(pubDate as string).toISOString()} itemprop="datePublished">
              {formattedDate}
            </time>
            {readingTime && <span itemprop="timeRequired">{readingTime} min read</span>}
          </div>

          <h1 class="text-4xl font-black leading-tight tracking-tight text-white md:text-6xl" itemprop="headline">{title}</h1>
          <p class="mt-5 text-xl leading-8 text-slate-300" itemprop="description">{description}</p>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            <div class="flex flex-wrap gap-2">
              {tags.map(tag => {
                const normalizedTag = tag.toLowerCase();
                const tagClass = 'rounded-full border border-white/10 bg-white/5 px-3 py-1 text-sm text-slate-300';
                return indexableTags.includes(normalizedTag) ? (
                  <a href={`/tags/${normalizedTag}/`} class={`${tagClass} hover:border-cyan-300/40 hover:text-cyan-200`}>
                    #{tag}
                  </a>
                ) : (
                  <span class={tagClass}>#{tag}</span>
                );
              })}
            </div>
          </div>

          <div class="mt-6 flex items-center gap-4">
            <div class="flex items-center gap-2 text-sm text-slate-500">
              <span>By</span>
              <span itemprop="author" itemscope itemtype="https://schema.org/Person">
                <meta itemprop="url" content={authorUrl} />
                <span itemprop="name" class="text-slate-300">{author}</span>
              </span>
            </div>
            <div class="flex items-center gap-2 text-sm">
              <span class="text-slate-500">Share:</span>
              <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(siteUrl + '/blog/' + postSlug + '/')}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener" class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-300 hover:border-cyan-300/40 hover:text-cyan-200" aria-label="Share on X (Twitter)">
                X
              </a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(siteUrl + '/blog/' + postSlug + '/')}`} target="_blank" rel="noopener" class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-300 hover:border-cyan-300/40 hover:text-cyan-200" aria-label="Share on LinkedIn">
                in
              </a>
            </div>
          </div>
        </div>

        {imageUrl && (
          <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-slate-900 shadow-2xl shadow-slate-950/40 md:rounded-3xl">
            <img
              src={imageUrl}
              alt={image?.alt || title}
              width="1200"
              height="630"
              class="h-48 w-full object-cover sm:h-64 lg:aspect-[16/9] lg:h-auto"
              loading="eager"
              decoding="async"
              itemprop="image"
            />
          </div>
        )}
      </div>
    </header>

    {headings && headings.length > 0 && (
      <nav class="overflow-hidden rounded-2xl border border-white/10 bg-slate-950/70 p-4 md:p-5" aria-label="Table of contents">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-400">On This Page</h2>
        <ul class="space-y-1.5">
          {headings.filter(h => h.depth <= 3).map(heading => (
            <li>
              <a
                href={`#${heading.slug}`}
                class:list={[
                  'block text-sm text-slate-400 hover:text-cyan-300 transition-colors',
                  heading.depth === 3 && 'ml-5',
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="prose prose-invert max-w-none prose-a:text-cyan-300 prose-code:text-cyan-200 prose-pre:border prose-pre:border-white/10 prose-pre:bg-slate-950">
      <slot />
    </div>

    <aside class="not-prose mt-8 rounded-2xl border border-amber-300/20 bg-amber-300/10 p-5 text-sm leading-6 text-amber-100" aria-label="AI content disclaimer">
      <p class="font-semibold text-amber-200">AI content notice</p>
      <p class="mt-2">This article is generated automatically with AI assistance and may include errors, omissions, or outdated details.</p>
      <p class="mt-2">Use it for research starting points only. Verify technical steps, pricing, security claims, and product availability with official sources before acting on them.</p>
    </aside>

    <div class="not-prose mt-8 flex flex-wrap items-center gap-4 border-t border-white/10 pt-8">
      <span class="text-sm text-slate-500">Share this post:</span>
      <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(siteUrl + '/blog/' + postSlug + '/')}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener" class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300 hover:border-cyan-300/40 hover:text-cyan-200">
        Share on X
      </a>
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(siteUrl + '/blog/' + postSlug + '/')}`} target="_blank" rel="noopener" class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300 hover:border-cyan-300/40 hover:text-cyan-200">
        Share on LinkedIn
      </a>
    </div>

    {formattedUpdatedDate && (
      <p class="mt-8 text-sm text-slate-500">
        Last updated: <time datetime={updatedDate instanceof Date ? updatedDate.toISOString() : new Date(updatedDate as string).toISOString()} itemprop="dateModified">{formattedUpdatedDate}</time>
      </p>
    )}

    <SummaryBox title={title} tags={tags} indexableTags={indexableTags} description={description} />
  </article>
</BaseLayout>
