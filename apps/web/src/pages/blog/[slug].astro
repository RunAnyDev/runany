---
import PostLayout from '@/layouts/PostLayout.astro';
import { getCollection, render } from 'astro:content';
import { getIndexableTags } from '@/utils/tags';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const getSlug = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-\d{6}-/, '').replace(/\.mdx?$/, '');
  return posts.map(post => ({
    params: { slug: getSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const getSlug = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-\d{6}-/, '').replace(/\.mdx?$/, '');

const extractFaqItems = (body: string) => {
  const faqSectionMatch = body.match(/## FAQ([\s\S]*?)(?:\n##\s|$)/);
  if (!faqSectionMatch) return [];

  const faqSection = faqSectionMatch[1];
  const lines = faqSection
    .split('\n')
    .map((line) => line.trim())
    .filter(Boolean);

  const items: { question: string; answer: string }[] = [];
  let currentQuestion = '';
  let currentAnswer = '';

  const pushCurrent = () => {
    if (currentQuestion && currentAnswer) {
      items.push({ question: currentQuestion, answer: currentAnswer.trim() });
    }
    currentQuestion = '';
    currentAnswer = '';
  };

  for (const line of lines) {
    const questionMatch = line.match(/^\*\*Q:\*\*\s*(.+)$/) ?? line.match(/^\*\*Q:\s*(.+?)\*\*$/);
    if (questionMatch) {
      pushCurrent();
      currentQuestion = questionMatch[1].trim();
      continue;
    }

    const answerMatch = line.match(/^\*\*A:\*\*\s*(.+)$/) ?? line.match(/^\*\*A:\s*(.+?)\*\*$/);
    if (answerMatch) {
      currentAnswer = answerMatch[1].trim();
      continue;
    }

    if (currentAnswer) {
      currentAnswer = `${currentAnswer} ${line}`.trim();
    }
  }

  pushCurrent();
  return items;
};

const faqItems = extractFaqItems(post.body);
const faqStructuredData = faqItems.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : undefined;

// Calculate reading time
const wordCount = post.body.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

// Get related posts (same category or tags)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const indexableTags = getIndexableTags(allPosts);
const relatedPosts = allPosts
  .filter(p => getSlug(p.id) !== getSlug(post.id))
  .filter(p => 
    p.data.category === post.data.category || 
    p.data.tags.some(t => post.data.tags.includes(t))
  )
  .slice(0, 3);

// Normalize date for display (handle string or Date from content collection)
const normalizeDate = (d: any): Date => {
  if (!d) return new Date();
  if (typeof d === 'string') return new Date(d);
  if (d instanceof Date) return d;
  return new Date();
};
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={normalizeDate(post.data.pubDate)}
  updatedDate={post.data.updatedDate ? normalizeDate(post.data.updatedDate) : undefined}
  category={post.data.category}
  tags={post.data.tags}
  indexableTags={indexableTags}
  image={post.data.image}
  readingTime={readingTime}
  headings={headings}
  slug={getSlug(post.id)}
  structuredData={faqStructuredData}
>
  <Content />
  
  {relatedPosts.length > 0 && (
    <div class="not-prose mt-12 border-t border-white/10 pt-8">
      <h3 class="text-xl font-semibold mb-6 text-white">Related Posts</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedPosts.map(p => (
          <a href={`/blog/${getSlug(p.id)}/`} class="rounded-2xl border border-white/10 bg-slate-950/60 p-5 no-underline transition hover:border-cyan-300/40">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-cyan-300">{p.data.category}</p>
            <p class="mt-3 font-medium text-white">{p.data.title}</p>
            <p class="mt-2 text-sm leading-6 text-slate-400">{p.data.description}</p>
            <p class="mt-3 text-sm text-slate-500">{normalizeDate(p.data.pubDate).toLocaleDateString()}</p>
          </a>
        ))}
      </div>
    </div>
  )}
</PostLayout>
