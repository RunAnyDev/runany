---
import PostLayout from '@/layouts/PostLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Calculate reading time
const wordCount = post.body.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

// Get related posts (same category or tags)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter(p => p.id.replace(/\.mdx?$/, '') !== post.id.replace(/\.mdx?$/, ''))
  .filter(p => 
    p.data.category === post.data.category || 
    p.data.tags.some(t => post.data.tags.includes(t))
  )
  .slice(0, 3);

// Normalize date for display (handle string or Date from content collection)
const normalizeDate = (d: any): Date => {
  if (!d) return new Date();
  if (typeof d === 'string') return new Date(d);
  if (d instanceof Date) return d;
  return new Date();
};
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={normalizeDate(post.data.pubDate)}
  updatedDate={post.data.updatedDate ? normalizeDate(post.data.updatedDate) : undefined}
  category={post.data.category}
  tags={post.data.tags}
  image={post.data.image}
  readingTime={readingTime}
  headings={headings}
>
  <Content />
  
  {relatedPosts.length > 0 && (
    <div class="not-prose mt-12 border-t border-white/10 pt-8">
      <h3 class="text-xl font-semibold mb-6 text-white">Related Posts</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedPosts.map(p => (
          <a href={`/blog/${p.id.replace(/\.mdx?$/, '')}`} class="card no-underline transition hover:border-cyan-300/40">
            <h4 class="font-medium mb-2 text-white">{p.data.title}</h4>
            <p class="text-sm text-slate-400">{normalizeDate(p.data.pubDate).toLocaleDateString()}</p>
          </a>
        ))}
      </div>
    </div>
  )}
</PostLayout>
