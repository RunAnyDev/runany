---
import PostLayout from '@/layouts/PostLayout.astro';
import { getCollection, render } from 'astro:content';
import { getIndexableTags } from '@/utils/tags';
import { getSlug } from '@/utils/slug';
import { buildSoftwareApplicationJsonLd } from '@/utils/seo-schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: getSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const extractFaqItems = (body: string) => {
  const faqSectionMatch = body.match(/##\s*FAQ([\s\S]*?)(?:\n##\s|$)/);
  if (!faqSectionMatch) return [];

  const faqSection = faqSectionMatch[1];
  const lines = faqSection
    .split('\n')
    .map((line) => line.trim())
    .filter(Boolean);

  const items: { question: string; answer: string }[] = [];
  let currentQuestion = '';
  let currentAnswer = '';

  // Strip leading Q:/A: markers and any wrapping **bold** so we can detect the Q/A role
  // even when the format varies across posts. Captures the actual question/answer text.
  const stripQAMarker = (line: string, marker: 'Q' | 'A'): string => {
    // Patterns we accept (any one):
    //   **Q:** question
    //   **Q: question**
    //   **Q: question         (unclosed bold, answer on next line)
    //   Q: question
    //   Q. question
    const reList = [
      new RegExp(`^\\*\\*${marker}:\\*\\*\\s*(.+)$`),     // **Q:** q
      new RegExp(`^\\*\\*${marker}:\\s*(.+?)\\*\\*$`),   // **Q: q**
      new RegExp(`^\\*\\*${marker}:\\s*(.+)$`),          // **Q: q   (unclosed)
      new RegExp(`^${marker}:\\s*(.+)$`),                // Q: q
      new RegExp(`^${marker}\\.\\s*(.+)$`),              // Q. q
    ];
    for (const re of reList) {
      const m = line.match(re);
      if (m) return m[1].replace(/\*\*$/, '').trim();
    }
    return '';
  };

  // Detect a "bolded question only" line, e.g. **Does it cost money?**
  // This is used by some posts (e.g. taste-skill) that omit the Q:/A: prefix entirely.
  // Fires when the previous pair (if any) is complete — i.e. we have an answer waiting
  // to be pushed, or this is the very first line.
  const isStandaloneBoldedQuestion = (line: string): string | null => {
    // Must be **...?** (or **...** with sentence-ending punctuation) on its own line
    const m = line.match(/^\*\*(.+?)\*\*\s*$/);
    if (!m) return null;
    const text = m[1].trim();
    if (text.length < 8 || text.length > 200) return null;
    if (!/[?!]/.test(text) && !/\b(is|are|do|does|can|how|what|why|when|where|who|which|will|should|would|could)\b/i.test(text)) {
      return null;
    }
    return text;
  };

  const pushCurrent = () => {
    if (currentQuestion && currentAnswer) {
      items.push({ question: currentQuestion, answer: currentAnswer.trim() });
    }
    currentQuestion = '';
    currentAnswer = '';
  };

  for (const line of lines) {
    const qText = stripQAMarker(line, 'Q');
    if (qText) {
      pushCurrent();
      currentQuestion = qText;
      continue;
    }

    const aText = stripQAMarker(line, 'A');
    if (aText) {
      currentAnswer = aText;
      continue;
    }

    // Fallback: bolded question with no Q: marker (taste-skill style)
    // Only fires when a question is starting fresh — either no current state, or
    // the previous Q/A pair is complete (we have a pending answer to push first).
    const boldQ = isStandaloneBoldedQuestion(line);
    if (boldQ) {
      if (currentAnswer) pushCurrent();
      currentQuestion = boldQ;
      continue;
    }

    // Continuation of the current answer (paragraph break inside an answer)
    if (currentAnswer) {
      currentAnswer = `${currentAnswer} ${line}`.trim();
    } else if (currentQuestion) {
      // First non-marker line after a question — start the answer.
      // Covers the bolded-question format (e.g. taste-skill) where the answer
      // is plain text with no A: prefix.
      currentAnswer = line;
    }
  }

  pushCurrent();
  return items;
};

const faqItems = extractFaqItems(post.body);
const faqStructuredData = faqItems.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : undefined;

// L4 fix: emit SoftwareApplication JSON-LD for product review posts.
// Review posts are tagged with category: 'review' and use the "Product – Tagline"
// title convention. The schema generator extracts the product name and builds
// a minimal but valid SoftwareApplication block.
const siteUrl = 'https://runany.dev';
const postSlug = getSlug(post.id);
const reviewSchema = post.data.category === 'review'
  ? buildSoftwareApplicationJsonLd(post.data, { siteUrl, postSlug })
  : undefined;

// Combine all structured data — BaseLayout accepts an array.
const combinedStructuredData = [faqStructuredData, reviewSchema].filter(Boolean);

// Calculate reading time
const wordCount = post.body.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

// Get related posts (same category or tags)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const indexableTags = getIndexableTags(allPosts);
const relatedPosts = allPosts
  .filter(p => getSlug(p.id) !== getSlug(post.id))
  .filter(p => 
    p.data.category === post.data.category || 
    p.data.tags.some(t => post.data.tags.includes(t))
  )
  .slice(0, 3);

// Normalize date for display (handle string or Date from content collection)
const normalizeDate = (d: any): Date => {
  if (!d) return new Date();
  if (typeof d === 'string') return new Date(d);
  if (d instanceof Date) return d;
  return new Date();
};
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={normalizeDate(post.data.pubDate)}
  updatedDate={post.data.updatedDate ? normalizeDate(post.data.updatedDate) : undefined}
  category={post.data.category}
  tags={post.data.tags}
  indexableTags={indexableTags}
  image={post.data.image}
  readingTime={readingTime}
  headings={headings}
  slug={getSlug(post.id)}
  structuredData={combinedStructuredData}
>
  <Content />
  
  {relatedPosts.length > 0 && (
    <div class="not-prose mt-12 border-t border-white/10 pt-8">
      <h3 class="text-xl font-semibold mb-6 text-white">Related Posts</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedPosts.map(p => (
          <a href={`/blog/${getSlug(p.id)}/`} class="rounded-2xl border border-white/10 bg-slate-950/60 p-5 no-underline transition hover:border-cyan-300/40">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-cyan-300">{p.data.category}</p>
            <p class="mt-3 font-medium text-white">{p.data.title}</p>
            <p class="mt-2 text-sm leading-6 text-slate-400">{p.data.description}</p>
            <p class="mt-3 text-sm text-slate-500">{normalizeDate(p.data.pubDate).toLocaleDateString()}</p>
          </a>
        ))}
      </div>
    </div>
  )}
</PostLayout>
