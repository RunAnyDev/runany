---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => {
  const dateDiff = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  if (dateDiff !== 0) return dateDiff;
  return a.id.localeCompare(b.id);
});
const categories = [...new Set(allPosts.map(p => p.data.category))];
const tags = [...new Set(allPosts.flatMap(p => p.data.tags))];

const selectedCategory = Astro.url.searchParams.get('category');
const selectedTag = Astro.url.searchParams.get('tag');

const activeClasses = 'bg-cyan-300 text-slate-950';
const inactiveClasses = 'border border-white/10 bg-white/5 text-slate-300 hover:text-cyan-200';
const activeTagClasses = 'bg-violet-300 text-slate-950';
const inactiveTagClasses = 'border border-white/10 bg-white/5 text-slate-300 hover:text-violet-200';

const filteredPosts = sortedPosts.filter(post => {
  if (selectedCategory && post.data.category.toLowerCase() !== selectedCategory.toLowerCase()) return false;
  if (selectedTag && !post.data.tags.map(t => t.toLowerCase()).includes(selectedTag.toLowerCase())) return false;
  return true;
});
const siteUrl = 'https://runany.dev';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'runany.dev Blog',
    description: 'All posts about AI setup, developer tools, local LLMs, self-hosted services, and automation workflows.',
    url: `${siteUrl}/blog/`,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: filteredPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${siteUrl}/blog/${post.id.replace(/\.mdx?$/, '')}/`,
      name: post.data.title,
    })),
  },
];
---

<BaseLayout title="Blog" description="All posts about AI setup, developer tools, local LLMs, self-hosted services, and automation workflows." structuredData={structuredData}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-10 rounded-3xl border border-white/10 bg-slate-950/70 p-8 shadow-2xl shadow-slate-950/30 md:p-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Runany Blog</p>
      <h1 class="text-4xl font-black tracking-tight text-white md:text-6xl">Tech notes for AI-first developers</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-300">
        Tutorials, reviews, and setup guides for AI setup, developer tools, local LLMs, self-hosted services, and automation.
      </p>
    </div>

    <div class="mb-10 grid gap-5 rounded-3xl border border-white/10 bg-slate-900/45 p-5 md:grid-cols-2">
      <div>
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Categories</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/blog" data-filter-link data-filter-type="all" class:list={['rounded-full px-4 py-2 text-sm font-medium transition-colors', !selectedCategory && !selectedTag ? activeClasses : inactiveClasses]}>
            All
          </a>
          {categories.map(cat => (
            <a href={`/blog?category=${encodeURIComponent(cat.toLowerCase())}`} data-filter-link data-filter-type="category" data-filter-value={cat.toLowerCase()} class:list={['rounded-full px-4 py-2 text-sm font-medium transition-colors', selectedCategory === cat.toLowerCase() ? activeClasses : inactiveClasses]}>
              {cat}
            </a>
          ))}
        </div>
      </div>

      <div>
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Tags</h2>
        <div class="flex flex-wrap gap-2">
          {tags.map(tag => (
            <a href={`/blog?tag=${encodeURIComponent(tag.toLowerCase())}`} data-filter-link data-filter-type="tag" data-filter-value={tag.toLowerCase()} class:list={['rounded-full px-3 py-1.5 text-sm transition-colors', selectedTag === tag.toLowerCase() ? activeTagClasses : inactiveTagClasses]}>
              #{tag}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mb-6 flex items-center justify-between gap-4">
      <h2 class="text-2xl font-bold text-white"><span data-post-count>{filteredPosts.length}</span> posts</h2>
      <a href="/blog" data-clear-filters class:list={['link text-sm', !(selectedCategory || selectedTag) && 'hidden']}>Clear filters</a>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {filteredPosts.map(post => (
        <div data-post-card data-category={post.data.category.toLowerCase()} data-tags={post.data.tags.map(tag => tag.toLowerCase()).join(',')}>
          <PostCard title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} slug={post.id.replace(/\.mdx?$/, '')} category={post.data.category} tags={post.data.tags} image={post.data.image} />
        </div>
      ))}
    </div>

    <p data-empty-state class:list={['rounded-2xl border border-white/10 bg-white/5 py-12 text-center text-slate-400', filteredPosts.length !== 0 && 'hidden']}>No posts found matching your criteria.</p>
  </section>

  <script define:vars={{ activeClasses, inactiveClasses, activeTagClasses, inactiveTagClasses }}>
    const normalize = (value) => (value || '').toLowerCase();
    const params = new URLSearchParams(window.location.search);
    const selectedCategory = normalize(params.get('category'));
    const selectedTag = normalize(params.get('tag'));
    const cards = Array.from(document.querySelectorAll('[data-post-card]'));
    const links = Array.from(document.querySelectorAll('[data-filter-link]'));
    const count = document.querySelector('[data-post-count]');
    const clear = document.querySelector('[data-clear-filters]');
    const empty = document.querySelector('[data-empty-state]');

    const setClasses = (element, enabled, active, inactive) => {
      element.classList.remove(...active.split(' '), ...inactive.split(' '));
      element.classList.add(...(enabled ? active : inactive).split(' '));
      element.setAttribute('aria-current', enabled ? 'page' : 'false');
    };

    links.forEach((link) => {
      const type = link.dataset.filterType;
      const value = normalize(link.dataset.filterValue);
      const enabled = type === 'all'
        ? !selectedCategory && !selectedTag
        : type === 'category'
          ? selectedCategory === value
          : selectedTag === value;
      setClasses(link, enabled, type === 'tag' ? activeTagClasses : activeClasses, type === 'tag' ? inactiveTagClasses : inactiveClasses);
    });

    let visible = 0;
    cards.forEach((card) => {
      const categoryMatches = !selectedCategory || normalize(card.dataset.category) === selectedCategory;
      const tags = normalize(card.dataset.tags).split(',').filter(Boolean);
      const tagMatches = !selectedTag || tags.includes(selectedTag);
      const matches = categoryMatches && tagMatches;
      card.classList.toggle('hidden', !matches);
      if (matches) visible += 1;
    });

    if (count) count.textContent = String(visible);
    clear?.classList.toggle('hidden', !selectedCategory && !selectedTag);
    empty?.classList.toggle('hidden', visible !== 0);
  </script>

  <style>
    [data-filter-link][aria-current="page"] {
      border-color: transparent;
      color: #020617;
    }

    [data-filter-link][data-filter-type="category"][aria-current="page"],
    [data-filter-link][data-filter-type="all"][aria-current="page"] {
      background-color: #67e8f9;
    }

    [data-filter-link][data-filter-type="tag"][aria-current="page"] {
      background-color: #c4b5fd;
    }
  </style>
</BaseLayout>
