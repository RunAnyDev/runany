---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => {
  const dateDiff = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  if (dateDiff !== 0) return dateDiff;
  return b.id.localeCompare(a.id);
});
const getSlug = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-\d{6}-/, '').replace(/\.mdx?$/, '');
const categories = [...new Set(allPosts.map((post) => post.data.category))].sort();
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();

const maxVisibleTags = 6;
const visibleTags = tags.slice(0, maxVisibleTags);
const hiddenTags = tags.slice(maxVisibleTags);
const hasMoreTags = hiddenTags.length > 0;

const postsPerPage = 6;
const initialPosts = sortedPosts.slice(0, postsPerPage);
const initialTotal = sortedPosts.length;
const hasMore = initialTotal > postsPerPage;

const siteUrl = 'https://runany.dev';
const pageTitle = 'Developer Blog – AI Setup, Dev Tools & Local LLMs';
const pageDescription = 'Browse tutorials, tool reviews, and setup guides covering AI setup, developer tools, local LLMs, self-hosted services, and automation workflows at runany.dev.';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'runany.dev Blog',
    description: pageDescription,
    url: `${siteUrl}/blog/`,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: sortedPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${siteUrl}/blog/${getSlug(post.id)}/`,
      name: post.data.title,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
    ],
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalURL={`${siteUrl}/blog/`} structuredData={structuredData}>
  <section class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm">
      <ol class="flex flex-wrap items-center gap-2 text-slate-500">
        <li><a href="/" class="hover:text-cyan-300">Home</a></li>
        <li>›</li>
        <li><span class="text-slate-300">Blog</span></li>
      </ol>
    </nav>

    <div class="mb-10 rounded-3xl border border-white/10 bg-slate-950/70 p-8 shadow-2xl shadow-slate-950/30 md:p-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Runany Blog</p>
      <h1 class="text-4xl font-black tracking-tight text-white md:text-6xl">Tech notes for AI-first developers</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-300">
        Tutorials, reviews, and setup guides for AI setup, developer tools, local LLMs, self-hosted services, and automation.
      </p>
    </div>

    <section aria-labelledby="categories-heading">
      <h2 id="categories-heading" class="mb-4 text-sm font-semibold uppercase tracking-wider text-slate-400">Categories</h2>
      <div class="mb-10 grid gap-4 rounded-3xl border border-white/10 bg-slate-950/60 p-6 md:grid-cols-3">
        <a href="/blog/" class="rounded-2xl border border-cyan-300/30 bg-cyan-300/10 px-5 py-4 text-sm font-medium text-cyan-200 transition hover:bg-cyan-300/20">All posts</a>
        {categories.map((category) => (
          <a href={`/category/${category.toLowerCase()}/`} class="rounded-2xl border border-white/10 bg-white/5 px-5 py-4 text-sm font-medium capitalize text-slate-300 transition hover:border-cyan-300/40 hover:text-cyan-200">
            {category}
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="tags-heading">
      <div class="mb-4 flex items-center justify-between gap-4">
        <h2 id="tags-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-400">Popular tags</h2>
        {hasMoreTags && (
          <button id="blog-tag-toggle" class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-slate-300 hover:border-violet-300/40 hover:text-violet-200" type="button">
            +{hiddenTags.length} more
          </button>
        )}
      </div>
      <div class="mb-10 rounded-3xl border border-white/10 bg-slate-950/60 p-6">
        <div class="flex flex-wrap gap-3">
          {visibleTags.map((tag) => (
            <a href={`/tags/${tag.toLowerCase()}/`} class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-slate-300 transition hover:border-violet-300/40 hover:text-violet-200">
              #{tag}
            </a>
          ))}
          {hasMoreTags && (
            <div id="blog-hidden-tags" class="hidden contents">
              {hiddenTags.map((tag) => (
                <a href={`/tags/${tag.toLowerCase()}/`} class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-slate-300 transition hover:border-violet-300/40 hover:text-violet-200">
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <section aria-labelledby="posts-heading">
      <div class="mb-4 flex items-center justify-between gap-3">
        <h2 id="posts-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-400">All Posts</h2>
        <button id="load-more-btn" class="rounded-full border border-cyan-300/30 bg-cyan-300/10 px-4 py-2 text-sm font-semibold text-cyan-200 hover:bg-cyan-300/20" type="button">
          Load more posts
        </button>
      </div>
      <div class="mb-4 flex items-center justify-between">
        <p class="text-sm text-slate-400" id="post-count">{initialTotal} posts</p>
        <div class="flex items-center gap-3" id="share-buttons">
          <span class="text-sm text-slate-500">Share:</span>
          <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(siteUrl + '/blog/')}&text=${encodeURIComponent('Tech notes for AI-first developers')}`} target="_blank" rel="noopener" class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-slate-300 hover:border-cyan-300/40 hover:text-cyan-200" aria-label="Share on X (Twitter)">
            X
          </a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(siteUrl + '/blog/')}`} target="_blank" rel="noopener" class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-slate-300 hover:border-cyan-300/40 hover:text-cyan-200" aria-label="Share on LinkedIn">
            in
          </a>
        </div>
      </div>

      <div id="posts-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {initialPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={getSlug(post.id)}
            category={post.data.category}
            tags={post.data.tags}
            image={post.data.image}
          />
        ))}
      </div>

      {hasMore && <div id="sentinel" class="mt-8 h-1" aria-hidden="true"></div>}

      <p id="empty-state" class:list={['mt-12 text-center text-slate-500', initialTotal !== 0 ? 'hidden' : '']}>
        No posts found.
      </p>

      <div id="status" class="mt-4 text-center text-sm text-slate-500" aria-live="polite"></div>
    </section>
  </section>

  <script define:vars={{ postsPerPage, initialTotal, hasMore }}>
    document.addEventListener('DOMContentLoaded', () => {
      const grid = document.getElementById('posts-grid');
      const loadMoreBtn = document.getElementById('load-more-btn');
      const sentinel = document.getElementById('sentinel');
      const statusEl = document.getElementById('status');
      const tagToggle = document.getElementById('blog-tag-toggle');
      const hiddenTags = document.getElementById('blog-hidden-tags');

      let currentPage = 1;
      const total = initialTotal;
      let hasMorePosts = hasMore;
      let loading = false;
      let observer = null;

      const updateStatus = () => {
        const showing = Math.min(currentPage * postsPerPage, total);
        statusEl.textContent = hasMorePosts ? `Showing ${showing} of ${total} posts` : `${total} posts`;
      };

      const createPostCard = (post) => {
        const clone = document.createElement('article');
        clone.className = 'group relative overflow-hidden rounded-3xl border border-white/10 bg-slate-950/75 shadow-2xl shadow-slate-950/30 transition duration-300 hover:-translate-y-1 hover:border-cyan-300/40 hover:shadow-cyan-950/30';
        clone.setAttribute('data-post-card-article', '');

        const date = new Date(post.pubDate);
        const formattedDate = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const imageMarkup = post.image ? `
          <div class="relative aspect-[16/9] overflow-hidden bg-slate-900">
            <img src="${post.image.url}" alt="${post.image.alt || post.title}" width="600" height="338" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/55 via-transparent to-transparent"></div>
          </div>` : '';
        const tagMarkup = (post.tags || []).slice(0, 3).map((tag) => `
          <span class="rounded-full bg-white/5 px-2.5 py-1 text-xs text-slate-300">#${tag}</span>`).join('');

        clone.innerHTML = `
          <a href="/blog/${post.slug}/" class="block" aria-label="Read ${post.title}">
            ${imageMarkup}
          </a>
          <div class="p-5">
            <div class="mb-3 flex items-center justify-between gap-3 text-xs font-medium text-slate-400">
              <a href="/category/${post.category.toLowerCase()}/" class="rounded-full border border-cyan-300/20 bg-cyan-300/10 px-3 py-1 text-cyan-200 hover:border-cyan-300/50">${post.category}</a>
              <time datetime="${date.toISOString()}">${formattedDate}</time>
            </div>
            <h3 class="mb-3 text-xl font-bold leading-tight text-white">
              <a href="/blog/${post.slug}/" class="hover:text-cyan-200 transition-colors">${post.title}</a>
            </h3>
            <p class="mb-4 line-clamp-2 text-sm leading-6 text-slate-400">${post.description}</p>
            <div class="flex flex-wrap gap-2">${tagMarkup}</div>
          </div>
        `;

        return clone;
      };

      const fetchAndAppend = async () => {
        if (loading || !loadMoreBtn) return;
        loading = true;
        loadMoreBtn.textContent = 'Loading...';

        try {
          const nextPage = currentPage + 1;
          const resp = await fetch(`/api/posts?page=${nextPage}&limit=${postsPerPage}`);
          if (!resp.ok) throw new Error('Failed to fetch');
          const data = await resp.json();

          data.posts.forEach((post) => {
            grid.append(createPostCard(post));
          });

          currentPage = data.page;
          hasMorePosts = data.hasMore;
          updateStatus();

          if (!data.hasMore) {
            if (observer) observer.disconnect();
            loadMoreBtn.style.display = 'none';
          }
        } catch (err) {
          statusEl.textContent = 'Failed to load posts. Try again.';
          console.error(err);
        } finally {
          loading = false;
          loadMoreBtn.textContent = 'Load more posts';
        }
      };

      if (loadMoreBtn) {
        if (!hasMorePosts) loadMoreBtn.style.display = 'none';
        loadMoreBtn.addEventListener('click', fetchAndAppend);
      }

      if ('IntersectionObserver' in window && sentinel && hasMorePosts) {
        observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          if (loading || !hasMorePosts) return;
          fetchAndAppend();
        }, { rootMargin: '360px 0px' });
        observer.observe(sentinel);
      }

      if (tagToggle && hiddenTags) {
        tagToggle.addEventListener('click', () => {
          const isHidden = hiddenTags.classList.contains('hidden');
          hiddenTags.classList.toggle('hidden', !isHidden);
          hiddenTags.classList.toggle('contents', isHidden);
          tagToggle.textContent = isHidden ? 'Show less' : `+${hiddenTags.querySelectorAll('a').length} more`;
        });
      }

      updateStatus();
    });
  </script>
</BaseLayout>
