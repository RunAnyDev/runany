---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get unique categories and tags
const categories = [...new Set(allPosts.map(p => p.data.category))];
const tags = [...new Set(allPosts.flatMap(p => p.data.tags))];

const selectedCategory = Astro.url.searchParams.get('category');
const selectedTag = Astro.url.searchParams.get('tag');

const filteredPosts = sortedPosts.filter(post => {
  if (selectedCategory && post.data.category.toLowerCase() !== selectedCategory.toLowerCase()) return false;
  if (selectedTag && !post.data.tags.map(t => t.toLowerCase()).includes(selectedTag.toLowerCase())) return false;
  return true;
});
---

<BaseLayout title="Blog | Example" description="All blog posts">
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-8">Blog</h1>
    
    <div class="flex flex-wrap gap-4 mb-8">
      <div>
        <h3 class="text-sm font-medium mb-2">Categories</h3>
        <div class="flex flex-wrap gap-2">
          <a
            href="/blog"
            class:list={['px-3 py-1 rounded-full text-sm', !selectedCategory ? 'bg-primary text-white' : 'bg-gray-200 dark:bg-gray-700']}
          >
            All
          </a>
          {categories.map(cat => (
            <a
              href={`/blog?category=${cat.toLowerCase()}`}
              class:list={['px-3 py-1 rounded-full text-sm', selectedCategory === cat.toLowerCase() ? 'bg-primary text-white' : 'bg-gray-200 dark:bg-gray-700']}
            >
              {cat}
            </a>
          ))}
        </div>
      </div>
      
      <div>
        <h3 class="text-sm font-medium mb-2">Tags</h3>
        <div class="flex flex-wrap gap-2">
          {tags.map(tag => (
            <a
              href={`/blog?tag=${tag.toLowerCase()}`}
              class:list={['px-3 py-1 rounded-full text-sm', selectedTag === tag.toLowerCase() ? 'bg-primary text-white' : 'bg-gray-200 dark:bg-gray-700']}
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {filteredPosts.map(post => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.slug}
          category={post.data.category}
          tags={post.data.tags}
          image={post.data.image}
        />
      ))}
    </div>
    
    {filteredPosts.length === 0 && (
      <p class="text-gray-500 text-center py-12">No posts found matching your criteria.</p>
    )}
  </section>
</BaseLayout>