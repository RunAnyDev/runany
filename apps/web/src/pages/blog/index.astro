---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(allPosts.map(p => p.data.category))];
const tags = [...new Set(allPosts.flatMap(p => p.data.tags))];

const selectedCategory = Astro.url.searchParams.get('category');
const selectedTag = Astro.url.searchParams.get('tag');

const filteredPosts = sortedPosts.filter(post => {
  if (selectedCategory && post.data.category.toLowerCase() !== selectedCategory.toLowerCase()) return false;
  if (selectedTag && !post.data.tags.map(t => t.toLowerCase()).includes(selectedTag.toLowerCase())) return false;
  return true;
});
---

<BaseLayout title="Blog | runany.dev" description="All posts about AI setup, developer tools, local LLMs, self-hosted services, and automation workflows.">
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-10 rounded-3xl border border-white/10 bg-slate-950/70 p-8 shadow-2xl shadow-slate-950/30 md:p-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Runany Blog</p>
      <h1 class="text-4xl font-black tracking-tight text-white md:text-6xl">Tech notes for AI-first developers</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-300">
        Tutorials, reviews, and setup guides for AI setup, developer tools, local LLMs, self-hosted services, and automation.
      </p>
    </div>

    <div class="mb-10 grid gap-5 rounded-3xl border border-white/10 bg-slate-900/45 p-5 md:grid-cols-2">
      <div>
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Categories</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/blog" class:list={['rounded-full px-4 py-2 text-sm font-medium transition-colors', !selectedCategory ? 'bg-cyan-300 text-slate-950' : 'border border-white/10 bg-white/5 text-slate-300 hover:text-cyan-200']}>
            All
          </a>
          {categories.map(cat => (
            <a href={`/blog?category=${cat.toLowerCase()}`} class:list={['rounded-full px-4 py-2 text-sm font-medium transition-colors', selectedCategory === cat.toLowerCase() ? 'bg-cyan-300 text-slate-950' : 'border border-white/10 bg-white/5 text-slate-300 hover:text-cyan-200']}>
              {cat}
            </a>
          ))}
        </div>
      </div>

      <div>
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Tags</h2>
        <div class="flex flex-wrap gap-2">
          {tags.map(tag => (
            <a href={`/blog?tag=${tag.toLowerCase()}`} class:list={['rounded-full px-3 py-1.5 text-sm transition-colors', selectedTag === tag.toLowerCase() ? 'bg-violet-300 text-slate-950' : 'border border-white/10 bg-white/5 text-slate-300 hover:text-violet-200']}>
              #{tag}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mb-6 flex items-center justify-between gap-4">
      <h2 class="text-2xl font-bold text-white">{filteredPosts.length} posts</h2>
      {(selectedCategory || selectedTag) && <a href="/blog" class="link text-sm">Clear filters</a>}
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {filteredPosts.map(post => (
        <PostCard title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} slug={post.id.replace(/\.mdx?$/, '')} category={post.data.category} tags={post.data.tags} image={post.data.image} />
      ))}
    </div>

    {filteredPosts.length === 0 && (
      <p class="rounded-2xl border border-white/10 bg-white/5 py-12 text-center text-slate-400">No posts found matching your criteria.</p>
    )}
  </section>
</BaseLayout>
