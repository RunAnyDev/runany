---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getIndexableTags } from '@/utils/tags';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.id.localeCompare(a.id));
const featuredPosts = sortedPosts.filter(p => p.data.featured).slice(0, 3);
const postsPerPage = 9;
const recentPosts = sortedPosts.slice(0, postsPerPage);
const hasMoreRecentPosts = sortedPosts.length > postsPerPage;
const indexableTags = getIndexableTags(allPosts);
const siteUrl = 'https://runany.dev';
const getSlug = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-\d{6}-/, '').replace(/\.mdx?$/, '');
const toIsoDate = (date: any) => date instanceof Date ? date.toISOString() : new Date(date).toISOString();
const topics = [
  { label: 'AI setup', slug: 'ai-setup' },
  { label: 'developer tools', slug: 'developer-tools' },
  { label: 'self-hosted', slug: 'self-hosted' },
  { label: 'Local LLM', slug: 'llm' },
];
const categoryCards = [
  {
    slug: 'ai-setup',
    title: 'AI Setup',
    description: 'Local LLMs, coding agents, model runtimes, and practical environment setup.',
  },
  {
    slug: 'dev-tools',
    title: 'Dev Tools',
    description: 'CLIs, IDE workflows, MCP tooling, debugging, and AI-native developer productivity.',
  },
  {
    slug: 'review',
    title: 'Reviews',
    description: 'Technical breakdowns of AI tools, APIs, startup products, and developer platforms.',
  },
  {
    slug: 'self-hosted',
    title: 'Self-Hosted',
    description: 'Private AI stacks, VPS deployments, and internal developer infrastructure.',
  },
];
const homepageTitle = 'runany.dev – AI Setup Guides, MCP Tools, Dev Reviews';
const homepageDescription = 'AI setup guides, MCP server walkthroughs, developer-tool reviews, local LLM notes, and self-hosted workflows for engineers building with AI.';
const prioritySlugs = [
  'openmonoagent-ai-setup-guide-open-source-c-ai-tool',
  'anysearch-mcp-server-unified-search',
  'anarlog-open-source-ai-meeting-notetaker',
  'vibesearchbench-ai-search-benchmark',
];
const priorityPosts = prioritySlugs
  .map((slug) => sortedPosts.find((post) => getSlug(post.id) === slug))
  .filter(Boolean);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'runany.dev',
    url: siteUrl,
    description: homepageDescription,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: homepageTitle,
    url: `${siteUrl}/`,
    description: homepageDescription,
    about: ['AI setup', 'MCP tools', 'developer tools', 'local LLMs', 'self-hosted workflows'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'runany.dev',
    url: siteUrl,
    blogPost: sortedPosts.slice(0, 12).map(post => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      url: `${siteUrl}/blog/${getSlug(post.id)}/`,
      datePublished: toIsoDate(post.data.pubDate),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    ],
  },
];
---

<BaseLayout title={homepageTitle} description={homepageDescription} canonicalURL={siteUrl + '/'} appendSiteNameToTitle={false} structuredData={structuredData}>
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
      <div>
        <p class="mb-4 inline-flex rounded-full border border-cyan-300/25 bg-cyan-300/10 px-4 py-2 text-sm font-semibold text-cyan-200">
          AI-native developer notes
        </p>
        <h1 class="max-w-4xl text-5xl font-black tracking-tight text-white md:text-7xl">
          Build faster with <span class="bg-gradient-to-r from-cyan-300 via-blue-300 to-violet-300 bg-clip-text text-transparent">AI tools</span>, local LLMs, and self-hosted stacks.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
          AI setup guides, MCP server walkthroughs, developer-tool reviews, local LLM notes, and self-hosted workflows for engineers building with AI.
        </p>
        <div class="mt-10 flex flex-wrap gap-4" data-cta-section="home-hero">
          <a href="/blog/" class="rounded-full border border-cyan-300/30 bg-cyan-300/10 px-6 py-3 text-sm font-semibold text-cyan-200 transition-all hover:border-cyan-300/60 hover:bg-cyan-300/20" data-cta="Browse Guides" data-cta-location="home-hero-primary">
            Browse Guides
          </a>
          <a href="/category/ai-setup/" class="rounded-full border border-white/10 bg-white/5 px-6 py-3 text-sm font-semibold text-slate-300 transition-all hover:border-white/20 hover:bg-white/10 hover:text-white" data-cta="AI Setup" data-cta-location="home-hero-secondary">
            AI Setup
          </a>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          {topics.map(topic => (
            <a href={`/tags/${topic.slug}/`} class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300 hover:border-cyan-300/40 hover:text-cyan-200">
              {topic.label}
            </a>
          ))}
        </div>
        {priorityPosts.length > 0 && (
          <div class="mt-8 rounded-3xl border border-white/10 bg-white/5 p-5">
            <p class="text-sm font-semibold uppercase tracking-[0.22em] text-cyan-300">Popular starting points</p>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {priorityPosts.map((post) => (
                <a href={`/blog/${getSlug(post.id)}/`} class="rounded-2xl border border-white/10 bg-slate-950/50 px-4 py-3 text-sm text-slate-300 transition hover:border-cyan-300/40 hover:text-white">
                  <span class="block font-semibold text-white">{post.data.title}</span>
                  <span class="mt-1 block text-slate-400">{post.data.description}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="relative rounded-3xl border border-white/10 bg-slate-900/70 p-5 shadow-2xl shadow-cyan-950/20">
        <div class="absolute -inset-1 -z-10 rounded-3xl bg-gradient-to-br from-cyan-400/20 via-violet-500/20 to-transparent blur-xl"></div>
        <div class="rounded-2xl border border-white/10 bg-slate-950 p-5 font-mono text-sm text-slate-300">
          <div class="mb-4 flex gap-2">
            <span class="h-3 w-3 rounded-full bg-red-400"></span>
            <span class="h-3 w-3 rounded-full bg-yellow-300"></span>
            <span class="h-3 w-3 rounded-full bg-lime-300"></span>
          </div>
          <p><span class="text-cyan-300">$</span> runany topics --latest</p>
          <p class="mt-4 text-lime-300">✓ local LLM setup</p>
          <p class="text-cyan-200">✓ automation workflows</p>
          <p class="text-violet-200">✓ dev tools reviews</p>
          <p class="text-slate-400">✓ hands-on tools</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <div class="mb-6">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Browse by Category</p>
      <h2 class="mt-2 text-3xl font-bold text-white">Category hubs for repeat topics</h2>
      <p class="mt-3 max-w-3xl text-slate-400">Jump into focused archives for AI setup, developer tooling, product reviews, and self-hosted workflows.</p>
    </div>
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {categoryCards.map((card) => (
        <a href={`/category/${card.slug}/`} class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 transition hover:-translate-y-1 hover:border-cyan-300/40 hover:shadow-2xl hover:shadow-cyan-950/20">
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Category</p>
          <h3 class="mt-3 text-2xl font-bold text-white">{card.title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-400">{card.description}</p>
          <span class="mt-5 inline-flex text-sm font-medium text-cyan-200">Open archive →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    {featuredPosts.length > 0 && (
      <div class="mb-14">
        <div class="mb-6 flex items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Featured</p>
            <h2 class="mt-2 text-3xl font-bold text-white">Start here</h2>
          </div>
          <a href="/blog/" class="link text-sm">View all posts</a>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {featuredPosts.map(post => (
            <PostCard title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} slug={getSlug(post.id)} category={post.data.category} tags={post.data.tags} indexableTags={indexableTags} image={post.data.image} featured={true} />
          ))}
        </div>
      </div>
    )}

    <div class="mb-6">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-violet-300">Recent Posts</p>
      <h2 class="mt-2 text-3xl font-bold text-white">Latest developer guides</h2>
    </div>

    <div id="home-post-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-posts-per-page={postsPerPage}>
      {recentPosts.map(post => (
        <PostCard title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} slug={getSlug(post.id)} category={post.data.category} tags={post.data.tags} indexableTags={indexableTags} image={post.data.image} />
      ))}
    </div>

    {hasMoreRecentPosts && (
      <div class="mt-10 flex flex-col items-center gap-4 text-center">
        <button
          id="home-load-more-posts"
          type="button"
          class="rounded-full border border-violet-300/30 bg-violet-300/10 px-6 py-3 text-sm font-semibold text-violet-100 transition hover:border-violet-300/70 hover:bg-violet-300/20"
        >
          Load more posts
        </button>
        <p id="home-infinite-scroll-status" class="text-sm text-slate-400" aria-live="polite">
          Scroll down to load more posts.
        </p>
        <div id="home-infinite-scroll-sentinel" class="h-1 w-full" aria-hidden="true"></div>
      </div>
    )}
  </section>

  {hasMoreRecentPosts && (
    <template id="home-post-card-template">
      <article class="group relative overflow-hidden rounded-3xl border border-white/10 bg-slate-950/75 shadow-2xl shadow-slate-950/30 transition duration-300 hover:-translate-y-1 hover:border-cyan-300/40 hover:shadow-cyan-950/30" data-post-card-article>
        <a data-card-link href="" class="block" aria-label="">
          <div class="relative aspect-[16/9] overflow-hidden bg-slate-900">
            <img data-card-img src="" alt="" width="600" height="338" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
            <div data-card-img-fallback class="relative h-full w-full bg-gradient-to-br from-violet-500/25 via-slate-800 to-cyan-400/25" style="display:none">
              <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.10)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.10)_1px,transparent_1px)] bg-[size:28px_28px] opacity-35"></div>
              <div class="absolute left-5 top-5 rounded-full border border-white/15 bg-slate-950/55 px-3 py-1 text-xs font-semibold text-cyan-100 backdrop-blur">
                <span data-card-category-label></span>
              </div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/55 via-transparent to-transparent"></div>
          </div>
        </a>
        <div class="p-5">
          <div class="mb-3 flex items-center justify-between gap-3 text-xs font-medium text-slate-400">
            <a data-card-category-link href="" class="rounded-full border border-cyan-300/20 bg-cyan-300/10 px-3 py-1 text-cyan-200 hover:border-cyan-300/50"></a>
            <time data-card-date datetime=""></time>
          </div>
          <h3 class="mb-3 text-xl font-bold leading-tight text-white">
            <a data-card-title href="" class="hover:text-cyan-200 transition-colors"></a>
          </h3>
          <p data-card-desc class="mb-4 line-clamp-2 text-sm leading-6 text-slate-400"></p>
          <div data-card-tags class="flex flex-wrap gap-2"></div>
        </div>
      </article>
    </template>

    <script define:vars={{ indexableTags }}>
      (function () {
        const grid = document.querySelector('#home-post-grid');
        const loadMoreBtn = document.querySelector('#home-load-more-posts');
        const statusEl = document.querySelector('#home-infinite-scroll-status');
        const sentinel = document.querySelector('#home-infinite-scroll-sentinel');
        const template = document.querySelector('#home-post-card-template');

        if (!grid || !loadMoreBtn || !statusEl || !sentinel || !template) return;

        const postsPerPage = Number(grid.dataset.postsPerPage || 9);
        let hasMorePosts = true;
        let currentPage = 1;
        let loading = false;

        const formatDate = function (d) {
          if (!d) return '';
          const date = new Date(d);
          return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        };

        const updateStatus = function () {
    if (!hasMorePosts) {
      loadMoreBtn.hidden = true;
      statusEl.textContent = 'All posts loaded.';
      return;
    }
    statusEl.textContent = 'Scroll down to load more posts.';
  };

        const createPostCard = function (post) {
    const clone = template.content.firstElementChild.cloneNode(true);

    const link = clone.querySelector('[data-card-link]');
    link.href = '/blog/' + post.slug + '/';
    link.setAttribute('aria-label', 'Read ' + post.title);

    const title = clone.querySelector('[data-card-title]');
    title.href = '/blog/' + post.slug + '/';
    title.textContent = post.title;

    const desc = clone.querySelector('[data-card-desc]');
    desc.textContent = post.description || '';

    const date = clone.querySelector('[data-card-date]');
    const d = new Date(post.pubDate);
    date.setAttribute('datetime', d.toISOString());
    date.textContent = formatDate(post.pubDate);

    const catLink = clone.querySelector('[data-card-category-link]');
    catLink.href = '/category/' + post.category.toLowerCase() + '/';
    catLink.textContent = post.category;

    const catLabel = clone.querySelector('[data-card-category-label]');
    if (catLabel) catLabel.textContent = post.category;

    const img = clone.querySelector('[data-card-img]');
    const fallback = clone.querySelector('[data-card-img-fallback]');
    if (post.image && post.image.url) {
      img.src = post.image.url;
      img.alt = post.image.alt || post.title;
      img.onerror = function () {
        this.style.display = 'none';
        if (fallback) fallback.style.display = '';
      };
    } else {
      img.style.display = 'none';
      if (fallback) fallback.style.display = '';
    }

    const tagsContainer = clone.querySelector('[data-card-tags]');
    (post.tags || []).slice(0, 3).forEach(function (tag) {
      const normalizedTag = tag.toLowerCase();
      const className = 'rounded-full bg-white/5 px-2.5 py-1 text-xs text-slate-300';
      if (indexableTags.includes(normalizedTag)) {
        const a = document.createElement('a');
        a.href = '/tags/' + normalizedTag + '/';
        a.className = className + ' hover:bg-white/10 hover:text-cyan-200';
        a.textContent = '#' + tag;
        tagsContainer.appendChild(a);
      } else {
        const span = document.createElement('span');
        span.className = className;
        span.textContent = '#' + tag;
        tagsContainer.appendChild(span);
      }
    });

    return clone;
  };

        const fetchAndAppend = async function () {
    if (loading) return;
    loading = true;
    loadMoreBtn.textContent = 'Loading...';

    try {
      const nextPage = currentPage + 1;
      const resp = await fetch('/api/posts/' + nextPage + '.json');
      if (!resp.ok) throw new Error('Failed to fetch');
      const data = await resp.json();

      data.posts.forEach(function (post) {
        grid.appendChild(createPostCard(post));
      });

      currentPage = data.page;
      hasMorePosts = data.hasMore;
      updateStatus();

      if (!data.hasMore && observer) observer.disconnect();
    } catch (err) {
      statusEl.textContent = 'Failed to load posts. Try again.';
      console.error(err);
    } finally {
      loading = false;
      loadMoreBtn.textContent = 'Load more posts';
    }
  };

        loadMoreBtn.addEventListener('click', fetchAndAppend);

        let observer = null;
        if ('IntersectionObserver' in window) {
          observer = new IntersectionObserver(function (entries) {
            if (!entries.some(function (entry) { return entry.isIntersecting; })) return;
            if (loading || !hasMorePosts) return;
            fetchAndAppend();
          }, { rootMargin: '360px 0px' });
          observer.observe(sentinel);
        }

        updateStatus();
      })();
    </script>
  )}
</BaseLayout>
