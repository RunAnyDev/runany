---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.id.localeCompare(a.id));
const featuredPosts = sortedPosts.filter(p => p.data.featured).slice(0, 3);
const postsPerPage = 9;
const recentPosts = sortedPosts.slice(0, postsPerPage);
const hasMoreRecentPosts = sortedPosts.length > postsPerPage;
const siteUrl = 'https://runany.dev';
const getSlug = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-\d{6}-/, '').replace(/\.mdx?$/, '');
const toIsoDate = (date: any) => date instanceof Date ? date.toISOString() : new Date(date).toISOString();
const topics = ['AI setup', 'developer tools', 'self-hosted', 'local LLM'];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'runany.dev',
    url: siteUrl,
    description: 'Tech blog about AI setup, developer tools, self-hosted services, and local LLMs for developers.',
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'runany.dev',
    url: siteUrl,
    blogPost: sortedPosts.slice(0, 12).map(post => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      url: `${siteUrl}/blog/${getSlug(post.id)}/`,
      datePublished: toIsoDate(post.data.pubDate),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Du',
    url: siteUrl,
  },
];
---

<BaseLayout title="AI Setup, Developer Tools, Local LLM" description="Tech blog about AI setup, developer tools, self-hosted services, and local LLMs for developers." structuredData={structuredData}>
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
      <div>
        <p class="mb-4 inline-flex rounded-full border border-cyan-300/25 bg-cyan-300/10 px-4 py-2 text-sm font-semibold text-cyan-200">
          AI-native developer notes
        </p>
        <h1 class="max-w-4xl text-5xl font-black tracking-tight text-white md:text-7xl">
          Build faster with <span class="bg-gradient-to-r from-cyan-300 via-blue-300 to-violet-300 bg-clip-text text-transparent">AI tools</span>, local LLMs, and self-hosted stacks.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
          Practical guides for AI setup, developer tools, self-hosted services, automation, and developer workflows.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          {topics.map(topic => (
            <a href={`/blog?tag=${topic.toLowerCase().replaceAll(' ', '-')}`} class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300 hover:border-cyan-300/40 hover:text-cyan-200">
              {topic}
            </a>
          ))}
        </div>
      </div>

      <div class="relative rounded-3xl border border-white/10 bg-slate-900/70 p-5 shadow-2xl shadow-cyan-950/20">
        <div class="absolute -inset-1 -z-10 rounded-3xl bg-gradient-to-br from-cyan-400/20 via-violet-500/20 to-transparent blur-xl"></div>
        <div class="rounded-2xl border border-white/10 bg-slate-950 p-5 font-mono text-sm text-slate-300">
          <div class="mb-4 flex gap-2">
            <span class="h-3 w-3 rounded-full bg-red-400"></span>
            <span class="h-3 w-3 rounded-full bg-yellow-300"></span>
            <span class="h-3 w-3 rounded-full bg-lime-300"></span>
          </div>
          <p><span class="text-cyan-300">$</span> runany topics --latest</p>
          <p class="mt-4 text-lime-300">✓ local LLM setup</p>
          <p class="text-cyan-200">✓ automation workflows</p>
          <p class="text-violet-200">✓ dev tools reviews</p>
          <p class="text-slate-400">✓ hand-ons tools</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    {featuredPosts.length > 0 && (
      <div class="mb-14">
        <div class="mb-6 flex items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Featured</p>
            <h2 class="mt-2 text-3xl font-bold text-white">Start here</h2>
          </div>
          <a href="/blog" class="link text-sm">View all posts</a>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {featuredPosts.map(post => (
            <PostCard title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} slug={getSlug(post.id)} category={post.data.category} tags={post.data.tags} image={post.data.image} featured={true} />
          ))}
        </div>
      </div>
    )}

    <div class="mb-6">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-violet-300">Recent Posts</p>
      <h2 class="mt-2 text-3xl font-bold text-white">Latest developer guides</h2>
    </div>

    <div id="home-post-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-posts-per-page={postsPerPage}>
      {recentPosts.map(post => (
        <PostCard title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} slug={getSlug(post.id)} category={post.data.category} tags={post.data.tags} image={post.data.image} />
      ))}
    </div>

    {hasMoreRecentPosts && (
      <div class="mt-10 flex flex-col items-center gap-4 text-center">
        <button
          id="home-load-more-posts"
          type="button"
          class="rounded-full border border-violet-300/30 bg-violet-300/10 px-6 py-3 text-sm font-semibold text-violet-100 transition hover:border-violet-300/70 hover:bg-violet-300/20"
        >
          Load more posts
        </button>
        <p id="home-infinite-scroll-status" class="text-sm text-slate-400" aria-live="polite">
          Scroll down to load more posts.
        </p>
        <div id="home-infinite-scroll-sentinel" class="h-1 w-full" aria-hidden="true"></div>
      </div>
    )}
  </section>

  {hasMoreRecentPosts && (
    <template id="home-post-card-template">
      <article class="group relative overflow-hidden rounded-3xl border border-white/10 bg-slate-950/75 shadow-2xl shadow-slate-950/30 transition duration-300 hover:-translate-y-1 hover:border-cyan-300/40 hover:shadow-cyan-950/30" data-post-card-article>
        <a data-card-link href="" class="block" aria-label="">
          <div class="relative aspect-[16/9] overflow-hidden bg-slate-900">
            <img data-card-img src="" alt="" width="600" height="338" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
            <div data-card-img-fallback class="relative h-full w-full bg-gradient-to-br from-violet-500/25 via-slate-800 to-cyan-400/25" style="display:none">
              <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.10)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.10)_1px,transparent_1px)] bg-[size:28px_28px] opacity-35"></div>
              <div class="absolute left-5 top-5 rounded-full border border-white/15 bg-slate-950/55 px-3 py-1 text-xs font-semibold text-cyan-100 backdrop-blur">
                <span data-card-category-label></span>
              </div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/55 via-transparent to-transparent"></div>
          </div>
        </a>
        <div class="p-5">
          <div class="mb-3 flex items-center justify-between gap-3 text-xs font-medium text-slate-400">
            <a data-card-category-link href="" class="rounded-full border border-cyan-300/20 bg-cyan-300/10 px-3 py-1 text-cyan-200 hover:border-cyan-300/50"></a>
            <time data-card-date datetime=""></time>
          </div>
          <h3 class="mb-3 text-xl font-bold leading-tight text-white">
            <a data-card-title href="" class="hover:text-cyan-200 transition-colors"></a>
          </h3>
          <p data-card-desc class="mb-4 line-clamp-2 text-sm leading-6 text-slate-400"></p>
          <div data-card-tags class="flex flex-wrap gap-2"></div>
        </div>
      </article>
    </template>

    <script>
      (function () {
        const grid = document.querySelector('#home-post-grid');
        const loadMoreBtn = document.querySelector('#home-load-more-posts');
        const statusEl = document.querySelector('#home-infinite-scroll-status');
        const sentinel = document.querySelector('#home-infinite-scroll-sentinel');
        const template = document.querySelector('#home-post-card-template');

        if (!grid || !loadMoreBtn || !statusEl || !sentinel || !template) return;

        const postsPerPage = Number(grid.dataset.postsPerPage || 9);
        let hasMorePosts = true;
        let currentPage = 1;
        let loading = false;

        const formatDate = function (d) {
          if (!d) return '';
          var date = new Date(d);
          return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        };

        var updateStatus = function () {
          if (!hasMorePosts) {
            loadMoreBtn.hidden = true;
            statusEl.textContent = 'All posts loaded.';
            return;
          }
          statusEl.textContent = 'Scroll down to load more posts.';
        };

        var createPostCard = function (post) {
          var clone = template.content.firstElementChild.cloneNode(true);

          var link = clone.querySelector('[data-card-link]');
          link.href = '/blog/' + post.slug + '/';
          link.setAttribute('aria-label', 'Read ' + post.title);

          var title = clone.querySelector('[data-card-title]');
          title.href = '/blog/' + post.slug + '/';
          title.textContent = post.title;

          var desc = clone.querySelector('[data-card-desc]');
          desc.textContent = post.description || '';

          var date = clone.querySelector('[data-card-date]');
          var d = new Date(post.pubDate);
          date.setAttribute('datetime', d.toISOString());
          date.textContent = formatDate(post.pubDate);

          var catLink = clone.querySelector('[data-card-category-link]');
          catLink.href = '/category/' + post.category.toLowerCase() + '/';
          catLink.textContent = post.category;

          var catLabel = clone.querySelector('[data-card-category-label]');
          if (catLabel) catLabel.textContent = post.category;

          var img = clone.querySelector('[data-card-img]');
          var fallback = clone.querySelector('[data-card-img-fallback]');
          if (post.image && post.image.url) {
            img.src = post.image.url;
            img.alt = post.image.alt || post.title;
            img.onerror = function () {
              this.style.display = 'none';
              if (fallback) fallback.style.display = '';
            };
          } else {
            img.style.display = 'none';
            if (fallback) fallback.style.display = '';
          }

          var tagsContainer = clone.querySelector('[data-card-tags]');
          (post.tags || []).slice(0, 3).forEach(function (tag) {
            var a = document.createElement('a');
            a.href = '/tags/' + tag.toLowerCase() + '/';
            a.className = 'rounded-full bg-white/5 px-2.5 py-1 text-xs text-slate-300 hover:bg-white/10 hover:text-cyan-200';
            a.textContent = '#' + tag;
            tagsContainer.appendChild(a);
          });

          return clone;
        };

        var fetchAndAppend = async function () {
          if (loading) return;
          loading = true;
          loadMoreBtn.textContent = 'Loading...';

          try {
            var nextPage = currentPage + 1;
            var resp = await fetch('/api/posts/' + nextPage + '.json');
            if (!resp.ok) throw new Error('Failed to fetch');
            var data = await resp.json();

            data.posts.forEach(function (post) {
              grid.appendChild(createPostCard(post));
            });

            currentPage = data.page;
            hasMorePosts = data.hasMore;
            updateStatus();

            if (!data.hasMore && observer) observer.disconnect();
          } catch (err) {
            statusEl.textContent = 'Failed to load posts. Try again.';
            console.error(err);
          } finally {
            loading = false;
            loadMoreBtn.textContent = 'Load more posts';
          }
        };

        loadMoreBtn.addEventListener('click', fetchAndAppend);

        var observer = null;
        if ('IntersectionObserver' in window) {
          observer = new IntersectionObserver(function (entries) {
            if (!entries.some(function (entry) { return entry.isIntersecting; })) return;
            if (loading || !hasMorePosts) return;
            fetchAndAppend();
          }, { rootMargin: '360px 0px' });
          observer.observe(sentinel);
        }

        updateStatus();
      })();
    </script>
  )}
</BaseLayout>
