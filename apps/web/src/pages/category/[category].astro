---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getSlug } from '@/utils/slug';
import { sortPostsByDateDesc } from '@/utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = [...new Set(posts.map(p => p.data.category))];
  
  return categories.map(category => ({
    params: { category: category.toLowerCase() },
    props: { category, posts: posts.filter(p => p.data.category.toLowerCase() === category.toLowerCase()) },
  }));
}

const { category, posts } = Astro.props;
const sortedPosts = sortPostsByDateDesc(posts);
const siteUrl = 'https://runany.dev';
const categoryUrl = `${siteUrl}/category/${category.toLowerCase()}/`;
const categoryDisplay = category.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()).replace(/\bAi\b/g, 'AI');
const categoryMeta: Record<string, { title: string; description: string; intro: string }> = {
  'ai-setup': {
    title: 'AI Setup Guides for Local LLMs and Agents',
    description: `Browse ${sortedPosts.length} AI setup guides on runany.dev — local LLMs, coding agents, and the environment work that goes with them.`,
    intro: 'Setup notes for local LLMs and coding agents. What to install, what to configure, what to skip.',
  },
  tutorial: {
    title: 'Step-by-Step AI Tutorials',
    description: `Browse ${sortedPosts.length} step-by-step tutorials on runany.dev for AI tools, developer workflows, and automation setups.`,
    intro: 'Tutorials that walk through real commands and config files — not high-level hand-waving.',
  },
  'dev-tools': {
    title: 'Developer Tools for AI Work',
    description: `Browse ${sortedPosts.length} guides and reviews of the developer tools behind AI workflows on runany.dev — coding agents, CLIs, MCP, IDE integrations.`,
    intro: 'Notes on the tools that show up in daily AI work: coding agents, CLIs, MCP servers, IDE plugins, and the debugging that comes with them.',
  },
  'self-hosted': {
    title: 'Self-Hosted AI Infrastructure Guides',
    description: `Browse ${sortedPosts.length} self-hosted setup guides on runany.dev — VPS deployments, private AI stacks, and the internal tooling around them.`,
    intro: 'Running AI on your own hardware. VPS deployments, private stacks, internal tooling — what breaks and what doesn\'t.',
  },
  review: {
    title: 'AI Tool Reviews and Breakdowns',
    description: `Browse ${sortedPosts.length} reviews of AI tools, platforms, and APIs on runany.dev, with notes on what survives production use.`,
    intro: 'Reviews of AI products, APIs, and platforms. What they do well, what they don\'t, what to skip.',
  },
  news: {
    title: 'AI Developer News, Launches, and Platform Updates',
    description: `Browse ${sortedPosts.length} posts tracking AI tool launches, platform updates, and open-source releases on runany.dev.`,
    intro: 'AI developer news: launches, platform updates, open-source releases. The stuff that changes your day-to-day setup.',
  },
};

const categoryDefaults = {
  title: `${categoryDisplay} Guides and Reviews`,
  description: `Browse ${sortedPosts.length} runany.dev posts in the ${categoryDisplay} category — practical guides, tooling notes, and reviews.`,
  intro: `Browse ${sortedPosts.length} posts in ${categoryDisplay}. Practical guides, tooling notes, and reviews — no fluff.`,
};

const categoryCopy = categoryMeta[category.toLowerCase()] ?? categoryDefaults;
const categoryTitle = categoryCopy.title;
const categoryDescription = categoryCopy.description;
const categoryIntro = categoryCopy.intro;
const shouldIndexCategory = sortedPosts.length >= 2;
const robots = shouldIndexCategory
  ? 'index, follow, max-image-preview:large, max-snippet:-1'
  : 'noindex, follow, max-image-preview:large, max-snippet:-1';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: categoryTitle,
    description: categoryDescription,
    url: categoryUrl,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: sortedPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${siteUrl}/blog/${getSlug(post.id)}/`,
      name: post.data.title,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
      { '@type': 'ListItem', position: 3, name: categoryTitle, item: categoryUrl },
    ],
  },
];
---

<BaseLayout title={categoryTitle} description={categoryDescription} canonicalURL={categoryUrl} robots={robots} structuredData={structuredData}>
  <section class="mx-auto max-w-5xl px-4 py-12 md:py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm">
      <ol class="flex flex-wrap items-center gap-2 text-slate-500">
        <li><a href="/" class="hover:text-cyan-300">Home</a></li>
        <li>›</li>
        <li><a href="/blog/" class="hover:text-cyan-300">Blog</a></li>
        <li>›</li>
        <li><span class="text-slate-300">{categoryDisplay}</span></li>
      </ol>
    </nav>

    <div class="mb-10 rounded-3xl border border-white/10 bg-slate-950/70 p-8 shadow-2xl shadow-slate-950/30 md:p-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Category</p>
      <h1 class="text-4xl font-black tracking-tight text-white md:text-5xl">{categoryTitle}</h1>
      <p class="mt-4 text-lg text-slate-400">{sortedPosts.length} posts in <span class="text-cyan-300">{categoryDisplay}</span></p>
      <p class="mt-4 max-w-3xl text-base leading-7 text-slate-400">{categoryIntro}</p>
    </div>

    <section aria-labelledby="posts-heading">
      <h2 id="posts-heading" class="mb-6 text-sm font-semibold uppercase tracking-wider text-slate-400">All Posts</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map(post => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={getSlug(post.id)}
          category={post.data.category}
          tags={post.data.tags}
          image={post.data.image}
        />
      ))}
    </div>
    </section>
  </section>
</BaseLayout>
