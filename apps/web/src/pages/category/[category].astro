---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = [...new Set(posts.map(p => p.data.category))];
  
  return categories.map(category => ({
    params: { category: category.toLowerCase() },
    props: { category, posts: posts.filter(p => p.data.category.toLowerCase() === category.toLowerCase()) },
  }));
}

const { category, posts } = Astro.props;
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`${category} | Example`} description={`Posts in category: ${category}`}>
  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="mb-8">
      <a href="/blog" class="text-sm text-gray-500 hover:text-primary mb-4 inline-block">← Back to Blog</a>
      <h1 class="text-4xl font-bold capitalize">{category}</h1>
      <p class="text-gray-500 mt-2">{sortedPosts.length} posts</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map(post => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.id.replace(/\.mdx?$/, '')}
          category={post.data.category}
          tags={post.data.tags}
          image={post.data.image}
        />
      ))}
    </div>
  </section>
</BaseLayout>