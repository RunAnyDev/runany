---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = [...new Set(posts.map(p => p.data.category))];
  
  return categories.map(category => ({
    params: { category: category.toLowerCase() },
    props: { category, posts: posts.filter(p => p.data.category.toLowerCase() === category.toLowerCase()) },
  }));
}

const { category, posts } = Astro.props;
const sortedPosts = posts.sort((a, b) => b.id.localeCompare(a.id));
const siteUrl = 'https://runany.dev';
const categoryUrl = `${siteUrl}/category/${category.toLowerCase()}/`;
const categoryDisplay = category.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
const categoryMeta: Record<string, { title: string; description: string; intro: string }> = {
  'ai-setup': {
    title: 'AI Setup Guides for Local LLMs and Agents',
    description: `Browse ${sortedPosts.length} AI setup guides covering local LLMs, coding agents, model configuration, inference tooling, and practical environment setup on runany.dev.`,
    intro: 'Hands-on setup guides for local LLMs, coding agents, model runtimes, and AI-native developer environments.',
  },
  tutorial: {
    title: 'Step-by-Step Tutorials for AI Developers',
    description: `Browse ${sortedPosts.length} step-by-step tutorials for AI tools, developer workflows, automation systems, and practical implementation details on runany.dev.`,
    intro: 'Tutorials with practical steps, commands, configuration notes, and implementation details for AI-native builders.',
  },
  'dev-tools': {
    title: 'Developer Tools for AI Engineers: Guides and Reviews',
    description: `Browse ${sortedPosts.length} developer-tool guides and reviews covering coding agents, CLIs, MCP tooling, IDE workflows, debugging, and automation on runany.dev.`,
    intro: 'Guides and reviews for coding agents, CLIs, IDE tooling, MCP integrations, debugging workflows, and AI developer productivity.',
  },
  'self-hosted': {
    title: 'Self-Hosted AI and Developer Infrastructure Guides',
    description: `Browse ${sortedPosts.length} self-hosted guides covering VPS deployments, private AI stacks, databases, internal tooling, and infrastructure workflows on runany.dev.`,
    intro: 'Self-hosted setup notes for private AI stacks, VPS deployments, infrastructure tooling, and internal developer platforms.',
  },
  review: {
    title: 'AI Tool Reviews and Technical Product Breakdowns',
    description: `Browse ${sortedPosts.length} technical reviews of AI tools, developer platforms, APIs, and startup products with practical evaluation notes on runany.dev.`,
    intro: 'Technical reviews and product breakdowns for AI tools, APIs, platforms, and developer infrastructure.',
  },
  news: {
    title: 'AI Developer News, Launches, and Platform Updates',
    description: `Browse ${sortedPosts.length} AI developer news posts covering launches, platform updates, open-source releases, and ecosystem changes on runany.dev.`,
    intro: 'News and update coverage focused on AI developer tools, platform launches, open-source releases, and workflow changes.',
  },
};

const categoryDefaults = {
  title: `${categoryDisplay} Guides and Reviews`,
  description: `Browse ${sortedPosts.length} runany.dev posts in the ${categoryDisplay} category, covering practical AI setup guides, developer tooling, reviews, and workflow notes.`,
  intro: `Browse ${sortedPosts.length} posts in ${categoryDisplay} with practical guides, reviews, and workflow notes for AI-native developers.`,
};

const categoryCopy = categoryMeta[category.toLowerCase()] ?? categoryDefaults;
const categoryTitle = categoryCopy.title;
const categoryDescription = categoryCopy.description;
const categoryIntro = categoryCopy.intro;
const shouldIndexCategory = sortedPosts.length >= 2;
const robots = shouldIndexCategory
  ? 'index, follow, max-image-preview:large, max-snippet:-1'
  : 'noindex, follow, max-image-preview:large, max-snippet:-1';
const getSlug = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-\d{6}-/, '').replace(/\.mdx?$/, '');
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: categoryTitle,
    description: categoryDescription,
    url: categoryUrl,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: sortedPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${siteUrl}/blog/${getSlug(post.id)}/`,
      name: post.data.title,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
      { '@type': 'ListItem', position: 3, name: categoryTitle, item: categoryUrl },
    ],
  },
];
---

<BaseLayout title={categoryTitle} description={categoryDescription} canonicalURL={categoryUrl} robots={robots} structuredData={structuredData}>
  <section class="mx-auto max-w-5xl px-4 py-12 md:py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm">
      <ol class="flex flex-wrap items-center gap-2 text-slate-500">
        <li><a href="/" class="hover:text-cyan-300">Home</a></li>
        <li>›</li>
        <li><a href="/blog/" class="hover:text-cyan-300">Blog</a></li>
        <li>›</li>
        <li><span class="text-slate-300">{categoryDisplay}</span></li>
      </ol>
    </nav>

    <div class="mb-10 rounded-3xl border border-white/10 bg-slate-950/70 p-8 shadow-2xl shadow-slate-950/30 md:p-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Category</p>
      <h1 class="text-4xl font-black tracking-tight text-white md:text-5xl">{categoryTitle}</h1>
      <p class="mt-4 text-lg text-slate-400">{sortedPosts.length} posts in <span class="text-cyan-300">{categoryDisplay}</span></p>
      <p class="mt-4 max-w-3xl text-base leading-7 text-slate-400">{categoryIntro}</p>
    </div>

    <section aria-labelledby="posts-heading">
      <h2 id="posts-heading" class="mb-6 text-sm font-semibold uppercase tracking-wider text-slate-400">All Posts</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map(post => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={getSlug(post.id)}
          category={post.data.category}
          tags={post.data.tags}
          image={post.data.image}
        />
      ))}
    </div>
    </section>
  </section>
</BaseLayout>
