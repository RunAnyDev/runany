---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap(p => p.data.tags))];
  
  return tags.map(tag => ({
    params: { tag: tag.toLowerCase() },
    props: { tag, posts: posts.filter(p => 
      p.data.tags.map(t => t.toLowerCase()).includes(tag.toLowerCase())
    )},
  }));
}

const { tag, posts } = Astro.props;
const sortedPosts = posts.sort((a, b) => b.id.localeCompare(a.id));
const siteUrl = 'https://runany.dev';
const tagUrl = `${siteUrl}/tags/${tag.toLowerCase()}/`;
const tagTitle = `#${tag} Guides and Tutorials`;
const tagDescription = `Explore ${sortedPosts.length} runany.dev posts tagged ${tag}, with practical setup guides and developer tool notes.`;
const getSlug = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-\d{6}-/, '').replace(/\.mdx?$/, '');
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: tagTitle,
    description: tagDescription,
    url: tagUrl,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: sortedPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${siteUrl}/blog/${getSlug(post.id)}/`,
      name: post.data.title,
    })),
  },
];
---

<BaseLayout title={tagTitle} description={tagDescription} structuredData={structuredData}>
  <section class="mx-auto max-w-5xl px-4 py-12 md:py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm">
      <ol class="flex flex-wrap items-center gap-2 text-slate-500">
        <li><a href="/" class="hover:text-cyan-300">Home</a></li>
        <li>›</li>
        <li><a href="/blog" class="hover:text-cyan-300">Blog</a></li>
        <li>›</li>
        <li><span class="text-slate-300">#{tag}</span></li>
      </ol>
    </nav>

    <div class="mb-10 rounded-3xl border border-white/10 bg-slate-950/70 p-8 shadow-2xl shadow-slate-950/30 md:p-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Tag</p>
      <h1 class="text-4xl font-black tracking-tight text-white md:text-5xl">#{tag}</h1>
      <p class="mt-4 text-lg text-slate-400">{sortedPosts.length} posts tagged #{tag}</p>
    </div>

    <section aria-labelledby="posts-heading">
      <h2 id="posts-heading" class="mb-6 text-sm font-semibold uppercase tracking-wider text-slate-400">All Posts</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={getSlug(post.id)}
            category={post.data.category}
            tags={post.data.tags}
            image={post.data.image}
          />
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
