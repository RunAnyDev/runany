---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap(p => p.data.tags))];
  
  return tags.map(tag => ({
    params: { tag: tag.toLowerCase() },
    props: { tag, posts: posts.filter(p => 
      p.data.tags.map(t => t.toLowerCase()).includes(tag.toLowerCase())
    )},
  }));
}

const { tag, posts } = Astro.props;
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`#${tag} | Example`} description={`Posts tagged with #${tag}`}>
  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="mb-8">
      <a href="/blog" class="text-sm text-gray-500 hover:text-primary mb-4 inline-block">← Back to Blog</a>
      <h1 class="text-4xl font-bold">#{tag}</h1>
      <p class="text-gray-500 mt-2">{sortedPosts.length} posts</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map(post => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.slug}
          category={post.data.category}
          tags={post.data.tags}
          image={post.data.image}
        />
      ))}
    </div>
  </section>
</BaseLayout>