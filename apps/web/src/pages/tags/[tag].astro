---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';
import { buildTagCountMap } from '@/utils/tags';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tagCounts = buildTagCountMap(posts);

  const tags = [...tagCounts.entries()]
    .filter(([, count]) => count >= 2)
    .map(([tag]) => tag);
  
  return tags.map(tag => ({
    params: { tag },
    props: { tag, posts: posts.filter(p => 
      p.data.tags.map(t => t.toLowerCase()).includes(tag.toLowerCase())
    )},
  }));
}

const { tag, posts } = Astro.props;
const sortedPosts = posts.sort((a, b) => b.id.localeCompare(a.id));
const siteUrl = 'https://runany.dev';
const normalizedTag = tag.toLowerCase();
const tagUrl = `${siteUrl}/tags/${normalizedTag}/`;
const tagDisplay = tag
  .replace(/-/g, ' ')
  .replace(/\b\w/g, (c: string) => c.toUpperCase())
  .replace(/\bAi\b/g, 'AI')
  .replace(/\bApi\b/g, 'API')
  .replace(/\bCli\b/g, 'CLI')
  .replace(/\bGpu\b/g, 'GPU')
  .replace(/\bLlm\b/g, 'LLM')
  .replace(/\bMcp\b/g, 'MCP')
  .replace(/\bSql\b/g, 'SQL')
  .replace(/\bYc\b/g, 'YC');
const tagMeta: Record<string, { title: string; description: string; intro: string }> = {
  'ai-agents': {
    title: 'AI Agent Guides, Reviews, and Tooling Notes',
    description: `Explore ${sortedPosts.length} runany.dev posts about AI agents, orchestration, memory, tool use, evaluation, and agent infrastructure.`,
    intro: 'Coverage focused on agent frameworks, orchestration patterns, memory systems, evaluation loops, and practical AI-agent tooling for developers.',
  },
  'developer-tools': {
    title: 'Developer Tool Guides and Technical Reviews',
    description: `Explore ${sortedPosts.length} runany.dev posts about developer tools, CLIs, IDE workflows, debugging, automation, and AI-native engineering productivity.`,
    intro: 'Practical notes on CLIs, IDE extensions, debugging flows, build tooling, and AI-native developer productivity systems.',
  },
  'open-source': {
    title: 'Open Source AI and Developer Tool Guides',
    description: `Explore ${sortedPosts.length} runany.dev posts covering open-source AI tools, self-hostable stacks, developer platforms, and practical setup notes.`,
    intro: 'Open-source tools, self-hostable platforms, and hands-on setup notes for engineers evaluating transparent, hackable software.',
  },
  'mcp': {
    title: 'MCP Guides for AI Tool Integration',
    description: `Explore ${sortedPosts.length} runany.dev posts covering MCP servers, tool integration, context plumbing, and AI-agent workflow design.`,
    intro: 'Coverage for Model Context Protocol tooling, server design, integration patterns, and developer workflows that rely on structured tool access.',
  },
  'self-hosted': {
    title: 'Self-Hosted AI Stack and Infra Guides',
    description: `Explore ${sortedPosts.length} runany.dev posts about self-hosted AI stacks, internal tooling, VPS deployments, and private developer infrastructure.`,
    intro: 'Self-hosted deployment notes for private AI stacks, internal platforms, and cost-conscious developer infrastructure.',
  },
  'ai-tools': {
    title: 'AI Tool Reviews, Setups, and Benchmarks',
    description: `Explore ${sortedPosts.length} runany.dev posts reviewing AI tools, APIs, assistants, and engineering workflows for practical adoption.`,
    intro: 'Technical reviews and setup notes for AI products, APIs, assistants, and shipping workflows used by working engineers.',
  },
};
const defaultTagMeta = {
  title: `${tagDisplay} Posts for AI Developers`,
  description: `Explore ${sortedPosts.length} runany.dev posts tagged ${tagDisplay}, with guides, reviews, and workflow notes for AI-native developers.`,
  intro: `Browse ${sortedPosts.length} posts tagged ${tagDisplay}, including practical setup notes, reviews, comparisons, and workflow patterns for engineers working with AI tools.`,
};
const tagCopy = tagMeta[normalizedTag] ?? defaultTagMeta;
const tagTitle = tagCopy.title;
const tagDescription = tagCopy.description;
const tagIntro = tagCopy.intro;
const getSlug = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-\d{6}-/, '').replace(/\.mdx?$/, '');
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: tagTitle,
    description: tagDescription,
    url: tagUrl,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: sortedPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${siteUrl}/blog/${getSlug(post.id)}/`,
      name: post.data.title,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
      { '@type': 'ListItem', position: 3, name: tagTitle, item: tagUrl },
    ],
  },
];
---

<BaseLayout title={tagTitle} description={tagDescription} canonicalURL={tagUrl} structuredData={structuredData}>
  <section class="mx-auto max-w-5xl px-4 py-12 md:py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm">
      <ol class="flex flex-wrap items-center gap-2 text-slate-500">
        <li><a href="/" class="hover:text-cyan-300">Home</a></li>
        <li>›</li>
        <li><a href="/blog/" class="hover:text-cyan-300">Blog</a></li>
        <li>›</li>
        <li><span class="text-slate-300">#{tag}</span></li>
      </ol>
    </nav>

    <div class="mb-10 rounded-3xl border border-white/10 bg-slate-950/70 p-8 shadow-2xl shadow-slate-950/30 md:p-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Tag</p>
      <h1 class="text-4xl font-black tracking-tight text-white md:text-5xl">{tagTitle}</h1>
      <p class="mt-4 text-lg text-slate-400">{sortedPosts.length} posts tagged <span class="text-cyan-300">#{tag}</span></p>
      <p class="mt-4 max-w-3xl text-base leading-7 text-slate-400">{tagIntro}</p>
    </div>

    <section aria-labelledby="posts-heading">
      <h2 id="posts-heading" class="mb-6 text-sm font-semibold uppercase tracking-wider text-slate-400">All Posts</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={getSlug(post.id)}
            category={post.data.category}
            tags={post.data.tags}
            image={post.data.image}
          />
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
