---
import BaseLayout from '@/layouts/BaseLayout.astro';

const siteUrl = 'https://runany.dev';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact runany.dev',
    url: `${siteUrl}/contact/`,
    description: 'Get in touch with Du at runany.dev for questions, suggestions, or collaborations.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${siteUrl}/contact/` },
    ],
  },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Du at runany.dev. Questions, topic suggestions, or collaboration — reach out via email or social."
  canonicalURL={`${siteUrl}/contact/`}
  structuredData={structuredData}
>
  <section class="mx-auto max-w-2xl px-4 py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm">
      <ol class="flex flex-wrap items-center gap-2 text-slate-500">
        <li><a href="/" class="hover:text-cyan-300 transition-colors">Home</a></li>
        <li aria-hidden="true">›</li>
        <li><span class="text-slate-300">Contact</span></li>
      </ol>
    </nav>

    <h1 class="text-4xl font-black tracking-tight text-white mb-4">Contact</h1>
    <p class="text-lg text-slate-300 mb-10 leading-8">
      Have a question, topic suggestion, or want to collaborate? I read every message and reply when I can.
    </p>

    <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-8 space-y-7">
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-2">Email</p>
        <a
          href="mailto:du@runany.dev"
          class="text-cyan-300 hover:text-cyan-200 text-lg font-medium transition-colors"
        >
          du@runany.dev
        </a>
      </div>
      <div class="border-t border-white/5 pt-7">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-2">X / Twitter</p>
        <a
          href="https://twitter.com/runanydev"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cyan-300 hover:text-cyan-200 text-lg font-medium transition-colors"
        >
          @runanydev
        </a>
      </div>
      <div class="border-t border-white/5 pt-7">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-2">GitHub</p>
        <a
          href="https://github.com/runanydev"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cyan-300 hover:text-cyan-200 text-lg font-medium transition-colors"
        >
          github.com/runanydev
        </a>
      </div>
    </div>

    <p class="mt-10 text-sm text-slate-500">
      Written by <span class="text-slate-400 font-medium">Du</span> — developer and AI tools enthusiast behind runany.dev.
      All content is original, written from hands-on experience with the tools covered.
    </p>
  </section>
</BaseLayout>
