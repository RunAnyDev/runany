---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found | Example" description="Page not found">
  <section class="max-w-5xl mx-auto px-4 py-24 text-center">
    <h1 class="text-9xl font-bold mb-4">404</h1>
    <p class="text-2xl text-gray-500 mb-8">Page not found</p>
    <a href="/" class="btn-primary inline-block">Go Home</a>
  </section>
</BaseLayout>