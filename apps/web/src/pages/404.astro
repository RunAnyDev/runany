---
import BaseLayout from '@/layouts/BaseLayout.astro';

// 404s should not be indexed — they add no value to search results and
// waste crawl budget. The robots="noindex, follow" directive still allows
// Google to follow links on this page to other parts of the site.
const robots = 'noindex, follow, max-image-preview:large, max-snippet:-1';

const siteUrl = 'https://runany.dev';
const popularPosts = [
  { slug: 'openmonoagent-ai-setup-guide-open-source-c-ai-tool', title: 'OpenMonoAgent Local Coding Agent' },
  { slug: 'anysearch-mcp-server-unified-search', title: 'AnySearch MCP Unified Search' },
  { slug: 'anarlog-open-source-ai-meeting-notetaker', title: 'Anarlog AI Meeting Notetaker' },
  { slug: 'vibesearchbench-ai-search-benchmark', title: 'VibeSearchBench AI Search Benchmark' },
];
---

<BaseLayout
  title="Page Not Found"
  description="The page you’re looking for doesn’t exist on runany.dev. Browse the blog index, search for a topic, or jump to a popular guide below."
  canonicalURL={`${siteUrl}/404/`}
  robots={robots}
>
  <section class="mx-auto max-w-3xl px-4 py-16 text-center md:py-24">
    <p class="mb-3 inline-flex rounded-full border border-cyan-300/25 bg-cyan-300/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-cyan-200">
      Error 404
    </p>
    <h1 class="text-5xl font-black tracking-tight text-white md:text-7xl">We can’t find that page</h1>
    <p class="mt-6 text-lg leading-8 text-slate-300">
      The link may be broken, the post may have moved, or the URL may be mistyped. Try the blog index, search by keyword, or jump into one of the popular guides below.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3" data-cta-section="404">
      <a
        href="/blog/"
        class="rounded-full border border-cyan-300/30 bg-cyan-300/10 px-6 py-3 text-sm font-semibold text-cyan-200 transition-all hover:border-cyan-300/60 hover:bg-cyan-300/20"
        data-cta="Browse Blog"
        data-cta-location="404-primary"
      >
        Browse the blog
      </a>
      <a
        href="/"
        class="rounded-full border border-white/10 bg-white/5 px-6 py-3 text-sm font-semibold text-slate-300 transition-all hover:border-white/20 hover:bg-white/10 hover:text-white"
        data-cta="Home"
        data-cta-location="404-secondary"
      >
        Back to home
      </a>
    </div>

    <form
      role="search"
      method="get"
      action="/blog/"
      class="mt-10 flex items-center gap-3 rounded-2xl border border-white/10 bg-slate-950/60 px-4 py-3 text-left focus-within:border-cyan-300/40"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-slate-500">
        <path fill="currentColor" d="M10 4a6 6 0 1 0 3.874 10.582l4.272 4.272l1.414-1.414l-4.272-4.272A6 6 0 0 0 10 4m-4 6a4 4 0 1 1 8 0a4 4 0 0 1-8 0" />
      </svg>
      <label for="404-search" class="sr-only">Search the blog</label>
      <input
        id="404-search"
        type="search"
        name="q"
        inputmode="search"
        autocomplete="off"
        placeholder="Search the blog by title or keyword"
        class="w-full border-0 bg-transparent p-0 text-sm text-white placeholder:text-slate-500 focus:outline-none focus:ring-0"
      />
      <button
        type="submit"
        class="rounded-full border border-cyan-300/30 bg-cyan-300/10 px-3 py-1.5 text-xs font-semibold text-cyan-200 hover:border-cyan-300/60 hover:bg-cyan-300/20"
      >
        Search
      </button>
    </form>

    <section class="mt-12 text-left" aria-labelledby="popular-404">
      <h2 id="popular-404" class="mb-4 text-sm font-semibold uppercase tracking-[0.24em] text-slate-400">
        Popular starting points
      </h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {popularPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}/`}
              class="block rounded-2xl border border-white/10 bg-slate-950/50 px-4 py-3 text-sm text-slate-300 transition hover:border-cyan-300/40 hover:text-white"
            >
              {post.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </section>
</BaseLayout>
