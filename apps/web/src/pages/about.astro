---
import BaseLayout from '@/layouts/BaseLayout.astro';

const siteUrl = 'https://runany.dev';
const pageUrl = `${siteUrl}/about/`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About runany.dev',
    url: pageUrl,
    description: 'About Du and runany.dev — an English tech blog covering AI tools, developer workflows, local LLMs, and self-hosted systems.',
    about: {
      '@type': 'Person',
      name: 'Du',
      url: pageUrl,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Du',
    url: pageUrl,
    email: 'du@runany.dev',
    sameAs: [
      'https://github.com/meesudzu',
      'https://github.com/runanydev',
      'https://twitter.com/runanydev',
    ],
    worksFor: {
      '@type': 'Organization',
      name: 'runany.dev',
      url: siteUrl,
    },
    knowsAbout: [
      'AI developer tools',
      'local LLM setup',
      'self-hosted infrastructure',
      'coding agents',
      'developer workflows',
      'MCP integrations',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'About', item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title="About Du and runany.dev"
  description="About Du, editor of runany.dev. Learn how the site researches AI tools, developer workflows, local LLMs, and self-hosted systems from hands-on testing."
  canonicalURL={pageUrl}
  structuredData={structuredData}
>
  <section class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm">
      <ol class="flex flex-wrap items-center gap-2 text-slate-500">
        <li><a href="/" class="hover:text-cyan-300 transition-colors">Home</a></li>
        <li aria-hidden="true">›</li>
        <li><span class="text-slate-300">About</span></li>
      </ol>
    </nav>

    <p class="mb-4 inline-flex rounded-full border border-cyan-300/25 bg-cyan-300/10 px-4 py-2 text-sm font-semibold text-cyan-200">
      About runany.dev
    </p>
    <h1 class="text-4xl font-black tracking-tight text-white md:text-6xl">About Du and runany.dev</h1>
    <p class="mt-6 text-lg leading-8 text-slate-300">
      runany.dev is an English tech blog focused on AI tools, developer workflows, local LLMs, MCP integrations, and self-hosted systems. The site is written for engineers who want practical notes, not generic summaries.
    </p>

    <div class="mt-10 rounded-3xl border border-white/10 bg-slate-950/70 p-8 shadow-2xl shadow-slate-950/30 md:p-10 space-y-8">
      <section>
        <h2 class="text-2xl font-bold text-white">Who writes the site</h2>
        <p class="mt-4 text-base leading-7 text-slate-300">
          I’m Du. I research, test, and write about developer products that matter to AI-native engineering teams: coding agents, cloud browser tooling, local-first AI setups, observability, API platforms, and self-hosted infrastructure.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-white">How content is researched</h2>
        <p class="mt-4 text-base leading-7 text-slate-300">
          Most posts start from primary sources: product docs, official websites, GitHub repositories, launch threads, public pricing, and hands-on setup attempts. Where a tool changes quickly, the post is framed as a dated snapshot rather than a timeless claim.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-white">Editorial focus</h2>
        <ul class="mt-4 space-y-3 text-base leading-7 text-slate-300">
          <li>- AI developer tools and coding agents</li>
          <li>- Local LLM setup and practical inference stacks</li>
          <li>- Self-hosted services and internal developer infrastructure</li>
          <li>- MCP tooling, automation workflows, and agent operations</li>
          <li>- Technical reviews of YC and open-source developer products</li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-white">Contact and profiles</h2>
        <div class="mt-4 space-y-3 text-base text-slate-300">
          <p>Email: <a href="mailto:du@runany.dev" class="text-cyan-300 hover:text-cyan-200">du@runany.dev</a></p>
          <p>GitHub: <a href="https://github.com/meesudzu" target="_blank" rel="noopener noreferrer" class="text-cyan-300 hover:text-cyan-200">github.com/meesudzu</a></p>
          <p>Site repo profile: <a href="https://github.com/runanydev" target="_blank" rel="noopener noreferrer" class="text-cyan-300 hover:text-cyan-200">github.com/runanydev</a></p>
          <p>X / Twitter: <a href="https://twitter.com/runanydev" target="_blank" rel="noopener noreferrer" class="text-cyan-300 hover:text-cyan-200">@runanydev</a></p>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
